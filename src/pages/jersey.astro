---
// src/pages/jersey.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from "astro:assets";
// Локальные изображения — положите файлы в src/assets/images/jersey/
import heroImg from "../assets/images/jersey/vikingjersey-hero.jpg";
import gallery1 from "../assets/images/jersey/vikingjersey-1.webp";
import gallery2 from "../assets/images/jersey/vikingjersey-2.webp";
import gallery3 from "../assets/images/jersey/vikingjersey-3.webp";
---

<BaseLayout
  title="Jersey — Здоровое, эффективное и беспроблемное поголовье | Scanova A/S"
  description="Джерсейская порода — идеальный выбор для роботизированного доения. Высокая жирность молока, отличное здоровье и спокойный нрав. Поставки из Дании."
  disableSnap={true}
>
  <!-- Hero Section с оптимизированным изображением -->
  <section class="hero-breed">
    <div class="hero-breed__image">
      <Image 
        src={heroImg} 
        alt="Джерсейская корова VikingJersey на пастбище" 
        width="1920" 
        height="1080" 
        format="webp" 
        quality={85} 
        loading="eager" 
        class="hero-breed__img" 
      />
      <div class="hero-breed__overlay"></div>
    </div>
    <div class="hero-breed__content">
      <div class="container">
        <h1 class="hero-breed__title">VikingJersey</h1>
        <p class="hero-breed__subtitle">Самый эффективный производитель молочного жира в мире</p>
        <p class="hero-breed__description">VikingJersey — это племенная программа, направленная на разведение здоровых, эффективных и беспроблемных коров с высокой пожизненной продуктивностью.</p>
        <a href="/#contact" class="btn btn--primary">Связаться с нами</a>
      </div>
    </div>
  </section>

  <!-- Основной контент -->
  <div class="container">
    <!-- Секция "Почему стоит выбрать джерсейскую породу?" -->
    <section class="content-section">
      <h2>Почему стоит выбрать джерсейскую породу?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🧬</span>
          <h3>Исключительное качество молока</h3>
          <p>Молоко с содержанием жира до 6% и белка до 4,4% идеально подходит для производства сыра, масла и других молочных продуктов с высокой добавленной стоимостью.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🦶</span>
          <h3>Отличное здоровье копыт</h3>
          <p>Крепкие конечности и естественная устойчивость к заболеваниям сводят к минимуму потребность в обработке копыт и сокращают ветеринарные расходы.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">😌</span>
          <h3>Спокойный нрав и легкость отела</h3>
          <p>Послушный характер и небольшие размеры телят делают джерсеев идеальными для роботизированного доения и легких отелов без вмешательства человека.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🌱</span>
          <h3>Эффективная конверсия корма</h3>
          <p>Затрачивая меньше корма на килограмм произведенного молока, джерсеи помогают снизить углеродный след и повысить рентабельность вашего хозяйства.</p>
        </div>
      </div>
    </section>

    <!-- Секция с видео и историей успеха -->
    <section class="content-section">
      <h2>Узнайте больше о породе</h2>
      <div class="video-wrapper">
        <iframe 
          width="560" 
          height="315" 
          src="https://www.youtube.com/embed/3uMZ8HvS5-U" 
          title="Видео о джерсейской породе VikingJersey" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div class="quote-block">
        <blockquote>
          «Мне нравится, что джерсеи сами заходят на доильную станцию и не требуют особого внимания. Они просто делают свою работу».
        </blockquote>
        <cite>— Фермер, Нидерланды</cite>
      </div>
    </section>

    <!-- Секция с характеристиками -->
    <section class="content-section">
      <h2>Характеристики породы</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">до 6%</div>
          <div class="stat-label">Жирность молока</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">до 4,4%</div>
          <div class="stat-label">Содержание белка</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">350–400 кг</div>
          <div class="stat-label">Вес взрослой коровы</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">7–8</div>
          <div class="stat-label">Средняя продуктивная жизнь (лактаций)</div>
        </div>
      </div>
    </section>

    <!-- Галерея с оптимизированными изображениями -->
    <section class="content-section">
      <h2>Галерея</h2>
      <div class="gallery">
        <Image 
          src={gallery1} 
          alt="Джерсейская корова на пастбище" 
          width="600" 
          height="400" 
          format="webp" 
          quality={80} 
          loading="lazy" 
        />
        <Image 
          src={gallery2} 
          alt="Стадо джерсейских коров на выгуле" 
          width="600" 
          height="400" 
          format="webp" 
          quality={80} 
          loading="lazy" 
        />
        <Image 
          src={gallery3} 
          alt="Джерсейская корова в стойле" 
          width="600" 
          height="400" 
          format="webp" 
          quality={80} 
          loading="lazy" 
        />
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-block">
        <h2>Готовы улучшить свое стадо?</h2>
        <p>Свяжитесь с нами, чтобы обсудить поставку племенных джерсеев из Дании и получить персональное коммерческое предложение.</p>
        <a href="/#contact" class="btn btn--primary">Оставить заявку</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ===== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ===== */
  :root {
    --dark: #0a0a0a;
    --accent: #10b981;
    --accent-hover: #059669;
    --text: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --border: rgba(255, 255, 255, 0.1);
    --card-bg: #141414;
    --transition-base: 0.25s ease;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ===== HERO С ИЗОБРАЖЕНИЕМ ЧЕРЕЗ <Image> ===== */
  .hero-breed {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    text-align: center;
    color: var(--text);
    overflow: hidden;
  }

  .hero-breed__image {
    position: absolute;
    inset: 0;
  }

  .hero-breed__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-breed__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7));
  }

  .hero-breed__content {
    position: relative;
    z-index: 2;
    padding: 40px 0;
  }

  .hero-breed__title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 900;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .hero-breed__subtitle {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 500;
    max-width: 700px;
    margin: 0 auto 24px;
    color: var(--muted);
  }

  .hero-breed__description {
    font-size: 1.1rem;
    max-width: 800px;
    margin: 0 auto 32px;
    color: var(--muted);
  }

  .btn {
    display: inline-block;
    padding: 12px 32px;
    border-radius: 40px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    transform: scale(1.02);
  }

  /* ===== КОНТЕНТНЫЕ БЛОКИ ===== */
  .content-section {
    margin: 80px 0;
  }

  .content-section h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 40px;
    color: var(--text);
    text-align: center;
  }

  /* ===== СЕТКА ПРЕИМУЩЕСТВ ===== */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .feature-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px 24px;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    text-align: center;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 18px 40px rgba(0,0,0,0.4);
  }

  .feature-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 20px;
  }

  .feature-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text);
  }

  .feature-card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ===== ВИДЕО ===== */
  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    max-width: 100%;
    border-radius: 20px;
    margin-bottom: 32px;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .quote-block {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 40px;
    text-align: center;
    margin: 0 auto;
    max-width: 800px;
  }

  .quote-block blockquote {
    font-size: 1.3rem;
    font-style: italic;
    color: var(--text);
    margin: 0 0 16px;
    line-height: 1.6;
  }

  .quote-block cite {
    font-size: 0.95rem;
    font-style: normal;
    color: var(--muted);
  }

  /* ===== ХАРАКТЕРИСТИКИ ===== */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px 20px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0,0,0,0.3);
    border-color: var(--accent);
  }

  .stat-number {
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    color: var(--text);
    margin-top: 12px;
  }

  /* ===== ГАЛЕРЕЯ ===== */
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .gallery img {
    flex: 1 1 300px;
    border-radius: 20px;
    width: 100%;
    height: auto;
    object-fit: cover;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    transition: transform 0.2s;
  }

  .gallery img:hover {
    transform: scale(1.02);
  }

  /* ===== ПРИЗЫВ К ДЕЙСТВИЮ ===== */
  .cta-section {
    margin: 80px 0;
  }

  .cta-block {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 64px 20px;
    text-align: center;
    color: var(--text);
  }

  .cta-block h2 {
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .cta-block p {
    color: var(--muted);
    margin-bottom: 32px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 16px;
    }
    .hero-breed {
      min-height: 60vh;
    }
    .stat-number {
      font-size: 2rem;
    }
  }
</style>