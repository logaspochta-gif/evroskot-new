---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BentoBreeds from '../components/BentoBreeds.astro';
import About from '../components/About.astro';
import Steps from '../components/Steps.astro';
import BreedsDetailed from '../components/BreedsDetailed.astro';
import Advantages from '../components/Advantages.astro';
import Staldren from '../components/Staldren.astro';
import Contact from '../components/Contact.astro';
import News from '../components/News.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../components/SideNav.astro';
---

<BaseLayout
  title="Scanova A/S — Племенной скот из Дании"
  description="Прямые поставки высокопродуктивных животных в РФ и СНГ."
>
  <main>
    <Hero />
    <BentoBreeds />
    <About />
    <News />
    <Steps />
    <BreedsDetailed />
    <Advantages />
    <Staldren />
    <Contact />
  </main>

  <!-- Футер как самостоятельная секция -->
  <section class="footer-section snap-section">
    <Footer />
  </section>

  <SideNav />
</BaseLayout>

<style is:global>
  .footer-section {
    scroll-snap-align: start;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--dark);
  }
</style>