---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BentoBreeds from '../components/BentoBreeds.astro';
import About from '../components/About.astro';
import Steps from '../components/Steps.astro';
import BreedsDetailed from '../components/BreedsDetailed.astro';
import Advantages from '../components/Advantages.astro';
import Staldren from '../components/Staldren.astro';
import Contact from '../components/Contact.astro';
import News from '../components/News.astro';
import SideNav from '../components/SideNav.astro';
---

<BaseLayout
  title="Scanova A/S — Племенной скот из Дании"
  description="Прямые поставки высокопродуктивных животных в РФ и СНГ."
>
  <main>
    <Hero />
    <BentoBreeds />
    <About />
    <News />
    <Steps />
    <BreedsDetailed />
    <Advantages />
    <Staldren />

    <section id="contact" class="contact-footer-section snap-section">
      <div class="contact-scroll-area">
        <Contact />
      </div>
    </section>
  </main>

  <SideNav />
</BaseLayout>

<style is:global>
  .contact-footer-section {
    scroll-snap-align: start;
    height: 100dvh;
    overflow-y: auto;
    overflow-x: hidden;
    background: var(--dark);
    scroll-snap-stop: always;
  }

  .contact-scroll-area {
    min-height: 110dvh;
    display: flex;
    flex-direction: column;
  }
</style>