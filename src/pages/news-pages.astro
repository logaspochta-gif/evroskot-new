---
// src/pages/news-pages.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import { fetchNewsFromVk } from '../pages/api/vk-news';

export const prerender = false;

export interface NewsItem {
  title: string;
  link: string;
  pubDate: string;
  content: string;
  image: string | null;
  isoDate: string;
  size?: 'small' | 'large' | 'wide';
  ownerId?: number;
  postId?: number;
}

// Утилиты для обработки контента VK (оставлены без изменений, т.к. уже оптимальны)
interface VkPhotoSize {
  type: string;
  url: string;
  width?: number;
  height?: number;
}

interface VkAttachment {
  type?: string;
  photo?: { sizes?: VkPhotoSize[] };
  video?: {
    image?: { url: string; width?: number; height?: number }[];
    title?: string;
  };
  doc?: {
    title?: string;
    preview?: { photo?: { sizes?: VkPhotoSize[] } };
  };
  link?: {
    title?: string;
    photo?: { sizes?: VkPhotoSize[] };
  };
}

function getAttachmentPreview(attachments: VkAttachment[]): string | null {
  if (!attachments?.length) return null;
  const first = attachments[0];

  if (first.photo?.sizes) {
    const sizes = first.photo.sizes;
    return (
      sizes.find((s) => s.type === 'x')?.url ||
      sizes.find((s) => s.type === 'y')?.url ||
      sizes[sizes.length - 1]?.url ||
      null
    );
  }

  if (first.video?.image?.length) {
    const images = first.video.image;
    return images[images.length - 1]?.url || null;
  }

  if (first.doc?.preview?.photo?.sizes) {
    const sizes = first.doc.preview.photo.sizes;
    return (
      sizes.find((s) => s.type === 'x')?.url ||
      sizes[sizes.length - 1]?.url ||
      null
    );
  }

  if (first.link?.photo?.sizes) {
    const sizes = first.link.photo.sizes;
    return (
      sizes.find((s) => s.type === 'k')?.url ||
      sizes.find((s) => s.type === 'x')?.url ||
      sizes[sizes.length - 1]?.url ||
      null
    );
  }

  return null;
}

function cleanVkText(text: string): string {
  return text
    .replace(/\[club\d+\|([^\]]+)\]/g, '$1')
    .replace(/\[id\d+\|([^\]]+)\]/g, '$1')
    .replace(/https?:\/\/\S+/g, '')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

function getAutoTitle(attachments: VkAttachment[]): string | null {
  if (!attachments?.length) return null;
  const first = attachments[0];

  if (first.video?.title) return first.video.title;
  if (first.doc?.title) return first.doc.title;
  if (first.link?.title) return first.link.title;
  return null;
}

function prepareTitleAndContent(
  postId: number,
  rawText: string,
  attachments: VkAttachment[]
): { title: string; content: string } {
  const manualTitles: Record<number, string> = {};

  if (manualTitles[postId]) {
    const title = manualTitles[postId];
    const cleaned = cleanVkText(rawText || '');
    if (!cleaned || cleaned.length <= 60) return { title, content: '' };
    let content = cleaned;
    if (content.startsWith(title)) content = content.slice(title.length).trim();
    if (content.length > 120) content = content.slice(0, 120) + '…';
    return { title, content };
  }

  const cleaned = cleanVkText(rawText || '');
  if (cleaned) {
    const firstSentenceMatch = cleaned.match(/^(.+?[.!?…])\s/);
    let title: string;
    let remaining: string;
    if (firstSentenceMatch) {
      title = firstSentenceMatch[1];
      remaining = cleaned.slice(firstSentenceMatch[0].length).trim();
    } else {
      title = cleaned.length > 60 ? cleaned.slice(0, 60) + '…' : cleaned;
      remaining = cleaned.length > 60 ? cleaned.slice(60).trim() : '';
    }
    if (remaining.startsWith(title)) remaining = remaining.slice(title.length).trim();
    if (remaining.length > 120) remaining = remaining.slice(0, 120) + '…';
    return { title, content: remaining };
  }

  const autoTitle = getAutoTitle(attachments);
  if (autoTitle) {
    const title = autoTitle.length > 70 ? autoTitle.slice(0, 70) + '…' : autoTitle;
    return { title, content: '' };
  }

  return { title: 'Без названия', content: '' };
}

// Загрузка новостей напрямую через функцию API
let news: NewsItem[] = [];

try {
  const posts = await fetchNewsFromVk();

  news = posts
    .filter((post) => {
      const cleaned = cleanVkText(post.text || '');
      return (
        cleaned.length > 0 ||
        (post.attachments && post.attachments.length > 0)
      );
    })
    .map((post): NewsItem => {
      const { title, content } = prepareTitleAndContent(
        post.id,
        post.text || '',
        post.attachments || []
      );
      const dateObj = new Date(post.date * 1000);
      const ownerId = -Math.abs(parseInt('99133048'));

      return {
        title,
        content,
        link: `https://vk.com/wall${ownerId}_${post.id}`,
        image: getAttachmentPreview(post.attachments || []),
        pubDate: dateObj.toLocaleDateString('ru-RU', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }),
        isoDate: dateObj.toISOString(),
        ownerId: ownerId,
        postId: post.id,
      };
    });
} catch (error) {
  console.error('Ошибка загрузки новостей:', error);
  news = [];
}

const sizePattern: Array<'large' | 'wide' | 'small'> = ['large', 'small', 'small', 'wide'];
const newsWithSizes = news.map((item, i) => ({
  ...item,
  size: sizePattern[i] || 'small',
}));
---

<BaseLayout
  title="Новости Scanova A/S — Племенной скот из Дании"
  description="Последние события, поставки и обновления компании Scanova A/S"
  disableSnap={true}
>
  <NewsList items={newsWithSizes} emptyMessage="Новости пока не загружены. Попробуйте позже." />
</BaseLayout>