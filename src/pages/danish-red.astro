---
// src/pages/danish-red.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from "astro:assets";
import vikingRedImg from '../assets/images/danish-red/danish-red_hero.jpg';
import gallery1 from '../assets/images/danish-red/vikingred1.webp';
import gallery2 from '../assets/images/danish-red/vikingred2.webp';
import gallery3 from '../assets/images/danish-red/vikingred3.webp';
---

<BaseLayout
  title="VikingRed — Здоровое, эффективное и беспроблемное поголовье | Scanova A/S"
  description="Красная датская порода (VikingRed) — идеальный выбор для устойчивого животноводства. Высокая жирность и белок, отличное здоровье, лёгкие отёлы и долголетие."
  disableSnap={true}
>
  <!-- Hero Section с оптимизированным фоновым изображением -->
  <section class="hero-breed">
    <div class="hero-breed__image">
      <Image 
        src={vikingRedImg} 
        alt="Красная датская корова VikingRed на пастбище" 
        width="1920" 
        height="1080" 
        format="webp" 
        quality={85} 
        loading="eager" 
        class="hero-breed__img" 
      />
      <div class="hero-breed__overlay"></div>
    </div>
    <div class="hero-breed__content">
      <div class="container">
        <h1 class="hero-breed__title">VikingRed</h1>
        <p class="hero-breed__subtitle">Красная датская порода — рождена для устойчивого развития</p>
        <p class="hero-breed__description">VikingRed — это племенная программа, направленная на разведение здоровых, фертильных и долгоживущих коров, которые превосходно чувствуют себя в любой системе содержания.</p>
        <a href="/#contact" class="btn btn--primary">Связаться с нами</a>
      </div>
    </div>
  </section>

  <!-- Основной контент -->
  <div class="container">
    <!-- Секция "Почему стоит выбрать красную датскую породу?" -->
    <section class="content-section">
      <h2>Почему стоит выбрать красную датскую породу?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🛡️</span>
          <h3>Отличное здоровье</h3>
          <p>Красная датская порода славится своей естественной устойчивостью к маститу и другим заболеваниям. Меньше ветеринарных затрат, больше спокойствия.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🥛</span>
          <h3>Высокое качество молока</h3>
          <p>Молоко с содержанием жира 4,2–4,5% и белка 3,6–3,8% идеально подходит для производства сыра, масла и свежих молочных продуктов.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🐄</span>
          <h3>Лёгкие отёлы</h3>
          <p>Низкая частота сложных отёлов делает породу одной из самых безопасных для коров и персонала. Телята рождаются крепкими и активными.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon" aria-hidden="true">🌍</span>
          <h3>Универсальность</h3>
          <p>VikingRed отлично адаптируются как к пастбищному, так и к интенсивному содержанию, обеспечивая стабильные надои в любых условиях.</p>
        </div>
      </div>
    </section>

    <!-- Секция с видео и историей успеха -->
    <section class="content-section">
      <h2>Узнайте больше о породе</h2>
      <div class="video-wrapper">
        <iframe 
          width="560" 
          height="315" 
          src="https://www.youtube.com/embed/sY-G5NZKP-8?si=ek3kFMSSooVfcBmO" 
          title="Видео о породе VikingRed" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <div class="quote-block">
        <blockquote>
          «Красные датские коровы приносят стабильный доход и почти не доставляют хлопот. Это фундамент моего стада уже 15 лет».
        </blockquote>
        <cite>— Фермер, Латвия</cite>
      </div>
    </section>

    <!-- Секция с характеристиками -->
    <section class="content-section">
      <h2>Характеристики породы</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">4,2–4,5%</div>
          <div class="stat-label">Жирность молока</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">3,6–3,8%</div>
          <div class="stat-label">Содержание белка</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">550–600 кг</div>
          <div class="stat-label">Вес взрослой коровы</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">6–8</div>
          <div class="stat-label">Средняя продуктивная жизнь (лактаций)</div>
        </div>
      </div>
    </section>

    <!-- Галерея с оптимизированными изображениями -->
    <section class="content-section">
      <h2>Галерея</h2>
      <div class="gallery">
        <Image 
          src={gallery1} 
          alt="Красная датская корова на зелёном пастбище" 
          width="600" 
          height="400" 
          format="webp" 
          quality={80} 
          loading="lazy" 
        />
        <Image 
          src={gallery2} 
          alt="Стадо красных датских коров в загоне" 
          width="600" 
          height="400" 
          format="webp" 
          quality={80} 
          loading="lazy" 
        />
        <Image 
          src={gallery3} 
          alt="Красная датская корова в стойле с телёнком" 
          width="600" 
          height="400" 
          format="webp" 
          quality={80} 
          loading="lazy" 
        />
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-block">
        <h2>Готовы улучшить свое стадо?</h2>
        <p>Свяжитесь с нами, чтобы обсудить поставку племенных красных датских коров из Дании и получить персональное коммерческое предложение.</p>
        <a href="/#contact" class="btn btn--primary">Оставить заявку</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :root {
    --dark: #0a0a0a;
    --accent: #10b981;
    --accent-hover: #059669;
    --text: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --border: rgba(255, 255, 255, 0.1);
    --card-bg: #141414;
    --transition-base: 0.25s ease;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hero секция с картинкой через <img> */
  .hero-breed {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    text-align: center;
    color: var(--text);
    overflow: hidden;
  }

  .hero-breed__image {
    position: absolute;
    inset: 0;
  }

  .hero-breed__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-breed__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7));
  }

  .hero-breed__content {
    position: relative;
    z-index: 2;
    padding: 40px 0;
  }

  .hero-breed__title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 900;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .hero-breed__subtitle {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 500;
    max-width: 700px;
    margin: 0 auto 24px;
    color: var(--muted);
  }

  .hero-breed__description {
    font-size: 1.1rem;
    max-width: 800px;
    margin: 0 auto 32px;
    color: var(--muted);
  }

  .btn {
    display: inline-block;
    padding: 12px 32px;
    border-radius: 40px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn--primary {
    background: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--accent-hover);
    transform: scale(1.02);
  }

  .content-section {
    margin: 80px 0;
  }

  .content-section:first-of-type {
    margin-top: 40px;
  }

  .content-section h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 40px;
    color: var(--text);
    text-align: center;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .feature-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px 24px;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    text-align: center;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 18px 40px rgba(0,0,0,0.4);
  }

  .feature-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 20px;
  }

  .feature-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text);
  }

  .feature-card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    max-width: 100%;
    border-radius: 20px;
    margin-bottom: 32px;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .quote-block {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 40px;
    text-align: center;
    margin: 0 auto;
    max-width: 800px;
  }

  .quote-block blockquote {
    font-size: 1.3rem;
    font-style: italic;
    color: var(--text);
    margin: 0 0 16px;
    line-height: 1.6;
  }

  .quote-block cite {
    font-size: 0.95rem;
    font-style: normal;
    color: var(--muted);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .stat-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px 20px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.3);
    border-color: var(--accent);
  }

  .stat-number {
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    color: var(--text);
    margin-top: 12px;
  }

  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .gallery img {
    flex: 1 1 300px;
    border-radius: 20px;
    width: 100%;
    height: auto;
    object-fit: cover;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s;
  }

  .gallery img:hover {
    transform: scale(1.02);
  }

  .cta-section {
    margin: 80px 0;
  }

  .cta-block {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 64px 20px;
    text-align: center;
    color: var(--text);
  }

  .cta-block h2 {
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .cta-block p {
    color: var(--muted);
    margin-bottom: 32px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 16px;
    }
    .stat-number {
      font-size: 2rem;
    }
  }
</style>