---
// src/components/Header.astro
---

<header class="navbar" id="navbar">
  <div class="logo">
    <a href="/" class="logo-link" aria-label="Scanova A/S — главная страница">
      <img
        src="/favicon.svg"
        alt=""
        class="logo-icon"
        aria-hidden="true"
      />
      <span class="logo-text">
        Scanova <span class="accent">A/S</span>
      </span>
    </a>
  </div>

  <button
    class="burger"
    id="burger"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="menu" id="menu" role="navigation">
    <a href="/#hero">Главная</a>
    
    <!-- Выпадающее меню "Породы" -->
    <div class="dropdown">
      <a href="/#breeds" class="dropdown-toggle">Породы</a>
      <ul class="dropdown-menu">
        <li><a href="/breeds/holstein">Голштинская</a></li>
        <li><a href="/breeds/jersey">Джерсейская</a></li>
        <li><a href="/breeds/danish-red">Красная Датская</a></li>
        <li><a href="/breeds/charolais">Шароле</a></li>
        <li><a href="/breeds/angus">Абердин-Ангус</a></li>
        <li><a href="/breeds/hereford">Герефордская</a></li>
        <li><a href="/breeds/limousin">Лимузин</a></li>
        <li><a href="/breeds/simmental">Симментальская</a></li>
      </ul>
    </div>

    <a href="/#about">О компании</a>
    <a href="/#staldren">Staldren®</a>
    <a href="/news-pages">Новости</a>
    <a href="/#contact" class="btn-contact">Связаться</a>
  </nav>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 5%;
    background: rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(5px);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .logo { display: flex; align-items: center; flex-shrink: 0; }

  .logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    position: relative;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .logo-link:hover { transform: translateY(-1px); opacity: 0.92; }
  .logo-link:focus-visible {
    outline: 2px solid rgba(16, 185, 129, 0.65);
    outline-offset: 6px;
    border-radius: 10px;
  }

  .logo-icon {
    height: 1.5em;
    width: auto;
    margin-right: 0.5em;
    display: block;
    filter: brightness(0) invert(1);
    transition: transform 0.25s ease;
  }
  .logo-link:hover .logo-icon {
    transform: scale(1.05);
  }

  .logo-text {
    font-size: clamp(1.2rem, 1vw + 1rem, 1.55rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
    text-shadow: 0 1px 4px rgba(0,0,0,0.3);
    white-space: nowrap;
  }

  .accent { color: var(--accent, #10b981); position: relative; }
  .accent::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 0%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transform: translateX(-50%);
    transition: width 0.3s ease, opacity 0.3s ease;
  }
  .logo-link:hover .accent::after {
    width: 70%;
    opacity: 0.8;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .menu a {
    color: #fff;
    text-decoration: none;
    font-size: clamp(0.85rem, 1vw + 0.5rem, 0.95rem);
    position: relative;
    padding-bottom: 5px;
    transition: opacity 0.3s ease;
  }
  .menu a:hover { opacity: 0.85; }
  .menu a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    width: 0%;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }
  .menu a:hover::after { width: 60%; }

  .btn-contact {
    background: var(--accent);
    color: #fff;
    padding: 0.8rem 1.8rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: inherit;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .btn-contact:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  /* ===== ВЫПАДАЮЩЕЕ МЕНЮ ===== */
  .dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .dropdown-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    padding-bottom: 5px;
  }

  .dropdown-toggle::after {
    content: '▼';
    font-size: 0.6rem;
    margin-left: 4px;
    transition: transform 0.3s ease;
  }

  .dropdown:hover .dropdown-toggle::after {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: -20px;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 16px;
    padding: 12px 0;
    min-width: 220px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
    list-style: none;
    margin: 0;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.6);
    z-index: 1001;
  }

  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu li {
    padding: 0;
    margin: 0;
  }

  .dropdown-menu a {
    display: block;
    padding: 10px 24px;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .dropdown-menu a:hover {
    background: rgba(16, 185, 129, 0.15);
    color: var(--accent);
    opacity: 1;
  }

  .dropdown-menu a::after {
    display: none; /* убираем подчёркивание для пунктов dropdown */
  }

  /* Бургер */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1200;
  }
  .burger span {
    width: 28px;
    height: 3px;
    background: #fff;
    border-radius: 20px;
    transition: 0.3s ease;
  }

  /* Мобильная версия */
  @media (max-width: 992px) {
    .navbar { padding: 1rem 5%; }
    .burger { display: flex; }
    .menu {
      position: absolute;
      top: 75px;
      right: 5%;
      width: 260px;
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      border-radius: 20px;
      background: rgba(0, 0, 0, 0.92);
      backdrop-filter: blur(15px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: 0.3s ease;
      will-change: transform, opacity;
    }
    .menu.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    /* На мобильных — выпадающее меню внутри бургера */
    .dropdown {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    .dropdown-menu {
      position: static;
      background: transparent;
      border: none;
      padding: 0 0 0 16px;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      min-width: 0;
    }

    .dropdown:hover .dropdown-menu {
      display: block;
    }

    .dropdown-menu a {
      padding: 8px 16px;
    }
  }

  @media (max-width: 768px) {
    .logo-text { font-size: 1.15rem; }
    .logo-icon { height: 1.3em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-link,
    .menu a,
    .btn-contact,
    .logo-icon,
    .dropdown-menu { transition: none; }
    .logo-link:hover { transform: none; }
    .dropdown:hover .dropdown-menu {
      transition: none;
    }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const expanded = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('active');
    });
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('active');
        burger.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>