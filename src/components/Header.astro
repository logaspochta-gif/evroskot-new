---
// src/components/Header.astro
---

<header class="navbar" id="navbar">
  <div class="logo">
    <a href="/" class="logo-link" aria-label="Scanova A/S — главная страница">
      <span class="logo-text">
        Scanova <span class="accent">A/S</span>
      </span>
    </a>
  </div>

  <button class="burger" id="burger" aria-label="Открыть меню">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="menu" id="menu">
    <a href="/#hero">Главная</a>
    <a href="/#breeds">Породы</a>
    <a href="/#about">О компании</a>
    <a href="/#staldren">Staldren®</a>
    <a href="/news-pages">Новости</a>
    <a href="/#contact">
      <button class="btn-contact">Связаться</button>
    </a>
  </nav>
</header>

<style>
  /* ===== НАВБАР ===== */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 5%;
    background: rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(5px);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  /* ===== ЛОГОТИП ===== */
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    position: relative;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .logo-link:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .logo-link:focus-visible {
    outline: 2px solid rgba(16, 185, 129, 0.65);
    outline-offset: 6px;
    border-radius: 10px;
  }

  .logo-text {
    font-size: clamp(1.2rem, 1vw + 1rem, 1.55rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #ffffff;
    font-family: Inter, Poppins, system-ui, sans-serif;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    white-space: nowrap;
    text-shadow: 0 1px 4px rgba(0,0,0,0.3);   /* лёгкая тень для лучшей читаемости */
  }

  .accent {
    color: var(--accent, #10b981);
    position: relative;
  }

  /* Декоративная линия под акцентом */
  .accent::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 0%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transform: translateX(-50%);
    transition: width 0.3s ease, opacity 0.3s ease;
  }

  .logo-link:hover .accent::after {
    width: 70%;
    opacity: 0.8;
  }

  /* ===== МЕНЮ ===== */
  .menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .menu a {
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    position: relative;
    padding-bottom: 5px;
    transition: opacity 0.3s ease;
  }

  .menu a:hover {
    opacity: 0.85;
  }

  .menu a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    width: 0%;
    height: 2px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .menu a:hover::after {
    width: 60%;
  }

  .btn-contact {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 0.8rem 1.8rem;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .btn-contact:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  /* ===== БУРГЕР ===== */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1200;
  }

  .burger span {
    width: 28px;
    height: 3px;
    background: #fff;
    border-radius: 20px;
    transition: 0.3s ease;
  }

  /* ===== МОБИЛЬНАЯ АДАПТАЦИЯ ===== */
  @media (max-width: 992px) {
    .navbar {
      padding: 1rem 5%;
    }

    .burger {
      display: flex;
    }

    .menu {
      position: absolute;
      top: 75px;
      right: 15%;
      width: 260px;
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      border-radius: 20px;
      background: rgba(0, 0, 0, 0.92);
      backdrop-filter: blur(15px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: 0.3s ease;
    }

    .menu.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .logo-text {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-link,
    .menu a,
    .btn-contact {
      transition: none;
    }

    .logo-link:hover {
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const burger = document.getElementById('burger');
    const menu = document.getElementById('menu');

    if (burger && menu) {
      burger.addEventListener('click', () => {
        menu.classList.toggle('active');
      });

      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.remove('active');
        });
      });
    }
  });
</script>