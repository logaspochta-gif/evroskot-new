---
// src/components/SideNav.astro
---
<Fragment>
  <nav class="side-nav" id="sideNav" aria-label="Навигация по секциям">
    <ul>
      <li><a href="#hero" data-section="hero" class="nav-dot"></a></li>
      <li><a href="#bento-breeds" data-section="bento-breeds" class="nav-dot"></a></li>
      <li><a href="#about" data-section="about" class="nav-dot"></a></li>
      <li><a href="#news" data-section="news" class="nav-dot"></a></li>
      <li><a href="#steps" data-section="steps" class="nav-dot"></a></li>
      <li><a href="#breeds" data-section="breeds" class="nav-dot"></a></li>
      <li><a href="#advantages" data-section="advantages" class="nav-dot"></a></li>
      <li><a href="#staldren" data-section="staldren" class="nav-dot"></a></li>
      <li><a href="#contact" data-section="contact" class="nav-dot"></a></li>
    </ul>
  </nav>
</Fragment>

<style>
  .side-nav {
    --side-dot-size: 12px;
    --side-dot-bg: rgba(255, 255, 255, 0.4);
    --side-dot-hover-bg: rgba(255, 255, 255, 0.8);
    --side-dot-active-bg: var(--accent, #10b981);
    --side-dot-active-border: #fff;
    --side-dot-active-shadow: 0 0 8px rgba(16, 185, 129, 0.5);

    position: fixed;
    top: 90%;
    right: 20px;
    transform: translateY(-90%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .side-nav.hidden {
    opacity: 0;
    transform: translateY(-90%) translateX(12px);
    pointer-events: none;
  }

  .side-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-dot {
    display: block;
    width: var(--side-dot-size);
    height: var(--side-dot-size);
    border-radius: 50%;
    background: var(--side-dot-bg);
    border: 2px solid transparent;
    transition: background 0.3s, border-color 0.3s, transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
  }

  .nav-dot:hover {
    background: var(--side-dot-hover-bg);
    transform: scale(1.2);
  }

  .nav-dot.active {
    background: var(--side-dot-active-bg);
    border-color: var(--side-dot-active-border);
    box-shadow: var(--side-dot-active-shadow);
    transform: scale(1.3);
  }

  @media (max-width: 768px) {
    .side-nav {
      right: 10px;
    }
    .nav-dot {
      width: 10px;
      height: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-nav,
    .nav-dot {
      transition: none;
    }
    .nav-dot:hover {
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.getElementById('sideNav');
    const dots = document.querySelectorAll('.nav-dot');

    // Собираем секции, соответствующие точкам
    const sections = Array.from(dots)
      .map(dot => {
        const id = dot.getAttribute('data-section');
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean) as HTMLElement[];

    let lastScrollY = window.scrollY;

    // Активация точки по индексу
    function activateDot(index: number) {
      dots.forEach((dot, i) => {
        const isActive = i === index;
        dot.classList.toggle('active', isActive);
        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    // Intersection Observer для точного определения активной секции
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;

          const index = sections.findIndex(section => section === entry.target);
          if (index >= 0) {
            requestAnimationFrame(() => activateDot(index));
          }
        });
      },
      {
        threshold: 0.45,
        rootMargin: '-10% 0px -10% 0px',
      }
    );

    sections.forEach(section => observer.observe(section));

    // Прокрутка по клику на точку
    dots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = dot.getAttribute('data-section');
        if (!targetId) return;

        const target = document.getElementById(targetId);
        if (!target) return;

        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
          block: 'start',
        });
      });
    });

    // Скрытие меню при активном скролле вниз на мобильных
    function handleScroll() {
      if (!nav) return;

      const currentScrollY = window.scrollY;

      if (
        window.innerWidth <= 640 &&
        currentScrollY > lastScrollY &&
        currentScrollY > 120
      ) {
        nav.classList.add('hidden');
      } else {
        nav.classList.remove('hidden');
      }

      lastScrollY = currentScrollY;
    }

    window.addEventListener(
      'scroll',
      () => requestAnimationFrame(handleScroll),
      { passive: true }
    );

    // Первичная активация
    if (sections.length > 0) {
      activateDot(0);
    }
  });
</script>