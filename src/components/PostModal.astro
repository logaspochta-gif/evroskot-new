---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <!-- CLOSE -->
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>

    <!-- COUNTER -->
    <div class="slide-counter" id="slideCounter"></div>

    <!-- CONTENT -->
    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>

    <!-- NAVIGATION -->
    <div class="nav-arrows" id="navArrows" style="display:none">
      <button class="nav-arrow nav-prev" id="navPrev" aria-label="Предыдущий">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button class="nav-arrow nav-next" id="navNext" aria-label="Следующий">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- POST INFO -->
    <div class="post-info" id="postInfo" style="display:none"></div>
  </div>
</div>

<style>
  /* Стили без изменений, как в последнем вашем коде */
  /* ... */
</style>

<script lang="js">
  // @ts-nocheck

  /** @type {import('swiper').Swiper | null} */
  let currentSwiper = null;
  let scale = 1;
  let zoomInitialized = false;

  function destroySwiper() {
    if (currentSwiper) {
      currentSwiper.destroy(true, true);
      currentSwiper = null;
    }
  }

  function pauseAllVideos() {
    document.querySelectorAll('.media-swiper video').forEach(v => v.pause());
  }

  function resetZoom() {
    const img = document.querySelector(".media-swiper .swiper-slide-active img");
    if (!img) return;
    img.style.transform = "scale(1)";
    const slide = img.closest(".swiper-slide");
    slide?.classList.remove("zoomed");
    scale = 1;
  }

  function initZoom() {
    if (zoomInitialized) return;
    zoomInitialized = true;

    const container = document.body;
    let initialDistance = 0;
    let initialScale = 1;

    container.addEventListener("dblclick", (e) => {
      const img = e.target.closest("img");
      if (!img) return;
      const slide = img.closest(".swiper-slide");
      if (!slide) return;
      if (slide.classList.contains("zoomed")) {
        img.style.transform = "scale(1)";
        slide.classList.remove("zoomed");
        scale = 1;
      } else {
        img.style.transform = "scale(2)";
        slide.classList.add("zoomed");
        scale = 2;
      }
    });

    container.addEventListener("touchmove", (e) => {
      if (e.touches.length !== 2) return;
      e.preventDefault();
      const img = document.querySelector(".media-swiper .swiper-slide-active img");
      if (!img) return;
      const currentDistance = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      if (!initialDistance) {
        initialDistance = currentDistance;
        initialScale = scale;
        return;
      }
      const nextScale = Math.min(Math.max(initialScale * (currentDistance / initialDistance), 1), 3);
      img.style.transform = `scale(${nextScale})`;
      scale = nextScale;
      const slide = img.closest(".swiper-slide");
      if (nextScale > 1) slide?.classList.add("zoomed");
      else slide?.classList.remove("zoomed");
    }, { passive: false });

    container.addEventListener("touchend", () => {
      initialDistance = 0;
    });
  }

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById("postModal");
    const content = document.getElementById("modalContent");
    const counter = document.getElementById("slideCounter");
    const navArrows = document.getElementById("navArrows");
    const info = document.getElementById("postInfo");

    if (!modal || !content) return;

    destroySwiper();
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    content.innerHTML = '<div class="modal-spinner"></div>';
    if (counter) counter.textContent = "";
    if (navArrows) navArrows.style.display = "none";
    if (info) info.style.display = "none";

    const isLocal = location.hostname === "localhost" || location.hostname === "127.0.0.1";

    try {
      let post = null;
      if (isLocal && window.VK_ACCESS_TOKEN_FOR_DEV) {
        const res = await fetch(
          `https://api.vk.com/method/wall.getById?posts=${ownerId}_${postId}&access_token=${window.VK_ACCESS_TOKEN_FOR_DEV}&v=5.131`
        );
        const data = await res.json();
        if (data.error) throw new Error(data.error.error_msg);
        post = data.response?.[0] ?? null;
      } else {
        const res = await fetch(`/api/get-post?owner_id=${ownerId}&post_id=${postId}`);
        if (!res.ok) throw new Error("Ошибка загрузки");
        post = await res.json();
      }
      if (!post) throw new Error("Пост не найден");

      const mediaItems = post.attachments?.filter(att => att.type === "photo" || att.type === "video") || [];
      const date = new Date(post.date * 1000);
      const formattedDate = date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });

      // Строим слайды
      const slides = await Promise.all(mediaItems.map(async (att, idx) => {
        if (att.type === "photo" && att.photo) {
          const img = att.photo.sizes.find(s => s.type === "w") || att.photo.sizes[att.photo.sizes.length - 1];
          return `<div class="swiper-slide" data-type="photo">
            <img src="${img.url}" alt="Фото ${idx + 1}" loading="lazy" />
          </div>`;
        }

        if (att.type === "video" && att.video) {
          const v = att.video;
          const accessKey = v.access_key || "";
          // Получаем прямые ссылки через наш прокси
          let videoUrl = null;
          try {
            const videoRes = await fetch(
              `/api/get-video?owner_id=${v.owner_id}&video_id=${v.id}&access_key=${accessKey}`
            );
            if (videoRes.ok) {
              const videoData = await videoRes.json();
              // VK возвращает файлы в поле files, предпочитаем mp4 максимального качества
              const files = videoData.files;
              if (files) {
                videoUrl = files.mp4_1080 || files.mp4_720 || files.mp4_480 || files.mp4_360 || files.mp4_240;
              }
            }
          } catch (e) {
            console.error('Не удалось получить прямые ссылки на видео', e);
          }

          if (videoUrl) {
            // Используем swiper-no-swiping, чтобы жесты не перехватывались Swiper
            return `
              <div class="swiper-slide" data-type="video">
                <div class="video-wrapper swiper-no-swiping">
                  <video
                    src="${videoUrl}"
                    controls
                    autoplay
                    muted
                    playsinline
                    preload="metadata"
                    style="width:100%;height:100%;object-fit:contain;background:#000;"
                  ></video>
                </div>
              </div>
            `;
          } else {
            // Если не удалось получить прямые ссылки, показываем стандартный iframe VK (запасной вариант)
            const iframeSrc = `https://vk.com/video_ext.php?oid=${v.owner_id}&id=${v.id}&hash=${v.access_key || ""}&hd=2&autoplay=0&js_api=1&disable_related_videos=1`;
            return `
              <div class="swiper-slide" data-type="video">
                <div class="video-wrapper">
                  <iframe
                    src="${iframeSrc}"
                    allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                    allowfullscreen
                    referrerpolicy="no-referrer"
                    style="width:100%;height:100%;border:none;"
                  ></iframe>
                </div>
              </div>
            `;
          }
        }

        return "";
      }));

      content.innerHTML = `
        <div class="media-carousel">
          <div class="swiper media-swiper">
            <div class="swiper-wrapper">
              ${slides.join('')}
            </div>
            <div class="swiper-pagination"></div>
          </div>
        </div>
      `;

      if (info) {
        info.innerHTML = `
          <div class="post-date">${formattedDate}</div>
          ${post.text ? `<div class="post-text">${post.text.replace(/\n/g, "<br>")}</div>` : ""}
        `;
        info.style.display = "block";
      }

      if (mediaItems.length > 0 && typeof Swiper !== "undefined") {
        currentSwiper = new Swiper(".media-swiper", {
          loop: false,
          speed: 350,
          spaceBetween: 0,
          centeredSlides: true,
          autoHeight: false,
          preloadImages: false,
          watchOverflow: true,
          grabCursor: true,
          keyboard: { enabled: true, onlyInViewport: true },
          pagination: { el: ".swiper-pagination", clickable: true },
          navigation: {
            nextEl: ".nav-next",
            prevEl: ".nav-prev",
          },
          on: {
            init(swiper) {
              updateCounter(swiper);
            },
            slideChange(swiper) {
              updateCounter(swiper);
              resetZoom();
              pauseAllVideos();
            },
          },
        });

        requestAnimationFrame(() => {
          currentSwiper?.update();
          currentSwiper?.updateSize();
          currentSwiper?.updateSlides();
        });

        function updateCounter(swiper) {
          if (!counter) return;
          counter.textContent = `${swiper.realIndex + 1} / ${mediaItems.length}`;
        }

        if (navArrows) {
          navArrows.style.display = mediaItems.length > 1 ? "flex" : "none";
        }
      }

      initZoom();
    } catch (err) {
      console.error(err);
      content.innerHTML = '<div style="margin:auto; color:#fff; text-align:center; padding:40px;">Не удалось загрузить пост.</div>';
    }
  }

  // Закрытие и всё остальное оставлено без изменений
  function closeModal() {
    const modal = document.getElementById("postModal");
    if (!modal) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    destroySwiper();
    resetZoom();
  }

  document.getElementById("modalClose")?.addEventListener("click", closeModal);
  document.getElementById("postModal")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeModal();
  });
  document.getElementById("navPrev")?.addEventListener("click", () => currentSwiper?.slidePrev());
  document.getElementById("navNext")?.addEventListener("click", () => currentSwiper?.slideNext());

  document.addEventListener("keydown", (e) => {
    const modal = document.getElementById("postModal");
    if (e.key === "Escape" && modal?.classList.contains("open")) closeModal();
  });

  // Свайп вниз для закрытия (без изменений)
  let touchStartY = 0;
  let touchCurrentY = 0;
  let isSwiping = false;

  document.addEventListener("touchstart", (e) => {
    const modal = document.getElementById("postModal");
    if (!modal?.classList.contains("open")) return;
    if (e.touches.length === 1) {
      touchStartY = e.touches[0].clientY;
      isSwiping = true;
    }
  });

  document.addEventListener("touchmove", (e) => {
    if (!isSwiping) return;
    touchCurrentY = e.touches[0].clientY;
    const diff = touchCurrentY - touchStartY;
    const container = document.querySelector(".modal-container");
    if (container && diff > 0) {
      container.style.transform = `translateY(${diff}px)`;
      container.style.opacity = `${1 - diff / window.innerHeight}`;
    }
  });

  document.addEventListener("touchend", () => {
    if (!isSwiping) return;
    isSwiping = false;
    const diff = touchCurrentY - touchStartY;
    const container = document.querySelector(".modal-container");
    if (container && diff > 120) {
      closeModal();
    } else if (container) {
      container.style.transform = "";
      container.style.opacity = "";
    }
    touchStartY = 0;
    touchCurrentY = 0;
  });

  window.openPostModal = openPostModal;
</script>