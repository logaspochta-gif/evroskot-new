---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <!-- Кнопка закрытия -->
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Счётчик слайдов -->
    <div class="slide-counter" id="slideCounter"></div>

    <!-- Контент (карусель) -->
    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>

    <!-- Кнопки навигации (стрелки) -->
    <div class="nav-arrows" id="navArrows" style="display:none">
      <button class="nav-arrow nav-prev" id="navPrev" aria-label="Предыдущий">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="nav-arrow nav-next" id="navNext" aria-label="Следующий">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Подпись (дата и текст) -->
    <div class="post-info" id="postInfo" style="display:none"></div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }
  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .modal-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #000;
  }
  .modal-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 50;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    backdrop-filter: blur(8px);
  }
  .modal-close:hover {
    background: rgba(255, 255, 255, 0.25);
  }
  .slide-counter {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    padding: 6px 16px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }
  .nav-arrows {
    position: absolute;
    top: 50%;
    left: 20px;
    right: 20px;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }
  .nav-arrow {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: none;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.2s;
    pointer-events: auto;
  }
  .nav-arrow:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
  }
  .post-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 35;
    padding: 80px 40px 40px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9),
      rgba(0, 0, 0, 0.4),
      transparent
    );
    pointer-events: none;
    color: #fff;
  }
  .post-date {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: var(--accent, #10b981);
  }
  .post-text {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.9;
  }
  .modal-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid rgba(255, 255, 255, 0.15);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: auto;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Swiper внутри модалки */
  .media-carousel {
    width: 100%;
    height: 100%;
  }
  .media-swiper {
    width: 100%;
    height: 100%;
  }
  .media-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    overflow: hidden;
  }
  .media-swiper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 0.3s ease;
    will-change: transform;
  }
  .media-swiper .swiper-slide.zoomed img {
    transform: scale(2);
    cursor: grab;
  }
  .video-wrapper {
    width: 100%;
    height: 100%;
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Адаптивность */
  @media (max-width: 768px) {
    .modal-close {
      width: 40px;
      height: 40px;
      top: 16px;
      right: 16px;
    }
    .nav-arrow {
      width: 44px;
      height: 44px;
    }
    .post-info {
      padding: 70px 20px 24px;
    }
    .post-text {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  // @ts-nocheck
  let currentSwiper = null;
  let scale = 1;
  let startDistance = 0;
  let startScale = 1;

  function destroySwiper() {
    if (currentSwiper) {
      currentSwiper.destroy(true, true);
      currentSwiper = null;
    }
  }

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById("postModal");
    const content = document.getElementById("modalContent");
    const counter = document.getElementById("slideCounter");
    const navArrows = document.getElementById("navArrows");
    const info = document.getElementById("postInfo");

    if (!modal || !content) return;

    destroySwiper();
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    content.innerHTML = '<div class="modal-spinner"></div>';
    if (counter) counter.textContent = "";
    if (navArrows) navArrows.style.display = "none";
    if (info) info.style.display = "none";

    const isLocal =
      location.hostname === "localhost" || location.hostname === "127.0.0.1";

    try {
      let post;
      if (isLocal && window.VK_ACCESS_TOKEN_FOR_DEV) {
        const res = await fetch(
          `https://api.vk.com/method/wall.getById?posts=${ownerId}_${postId}&access_token=${window.VK_ACCESS_TOKEN_FOR_DEV}&v=5.131`,
        );
        const data = await res.json();
        if (data.error) throw new Error(data.error.error_msg);
        post = data.response?.[0];
      } else {
        const res = await fetch(
          `/api/get-post?owner_id=${ownerId}&post_id=${postId}`,
        );
        if (!res.ok) throw new Error("Ошибка загрузки");
        post = await res.json();
      }
      if (!post) throw new Error("Пост не найден");

      const mediaItems =
        post.attachments?.filter(
          (att) => att.type === "photo" || att.type === "video",
        ) || [];
      const date = new Date(post.date * 1000);
      const formattedDate = date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });

      // Формируем слайды
      const slides = mediaItems
        .map((att, idx) => {
          if (att.type === "photo" && att.photo) {
            const img =
              att.photo.sizes.find((s) => s.type === "w") ||
              att.photo.sizes[att.photo.sizes.length - 1];
            return `<div class="swiper-slide" data-type="photo">
            <img src="${img.url}" alt="Фото ${idx + 1}" loading="lazy" />
          </div>`;
          }
          if (att.type === "video" && att.video) {
            const v = att.video;
            const iframeSrc = `https://vk.com/video_ext.php?oid=${v.owner_id}&id=${v.id}&hash=${v.access_key || ""}&hd=2&autoplay=0&js_api=1&disable_related_videos=1`;
            return `<div class="swiper-slide" data-type="video">
            <div class="video-wrapper">
              <iframe src="${iframeSrc}" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="no-referrer"></iframe>
            </div>
          </div>`;
          }
          return "";
        })
        .join("");

      // Документы (отдельно)
      const docs = post.attachments?.filter((att) => att.type === "doc") || [];
      let docsHtml = "";
      if (docs.length > 0) {
        docsHtml = `<div style="position:absolute; top:80px; left:20px; z-index:50; display:flex; flex-direction:column; gap:8px;">
          ${docs
            .map((att) => {
              if (!att.doc) return "";
              return `<a href="${att.doc.url}" target="_blank" rel="noopener" style="padding:8px 14px; border-radius:12px; background:rgba(255,255,255,0.1); color:#fff; text-decoration:none; backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.1);">📄 ${att.doc.title}</a>`;
            })
            .join("")}
        </div>`;
      }

      content.innerHTML = `
        <div class="media-carousel">
          <div class="swiper media-swiper">
            <div class="swiper-wrapper">${slides}</div>
            <div class="swiper-pagination"></div>
          </div>
          ${docsHtml}
        </div>
      `;

      // Подпись (дата + текст)
      if (info) {
        info.innerHTML = `
          <div class="post-date">${formattedDate}</div>
          ${post.text ? `<div class="post-text">${post.text.replace(/\n/g, "<br>")}</div>` : ""}
        `;
        info.style.display = "block";
      }

      // Swiper
      if (mediaItems.length > 0 && typeof Swiper !== "undefined") {
        currentSwiper = new Swiper(".media-swiper", {
          loop: false,
          speed: 350,
          spaceBetween: 0,
          grabCursor: true,
          watchOverflow: true,
          autoHeight: false,
          preloadImages: false,
          keyboard: { enabled: true, onlyInViewport: true },
          mousewheel: false, // убираем, чтобы не мешало зуму
          pagination: { el: ".swiper-pagination", clickable: true },
          navigation: {
            nextEl: ".nav-next",
            prevEl: ".nav-prev",
          },
          on: {
            init: function () {
              updateCounter(this);
            },
            slideChange: function () {
              updateCounter(this);
              resetZoom(); // сбрасываем зум при перелистывании
            },
          },
        });

        // Обновление счётчика
        function updateCounter(swiper) {
          if (counter) {
            const total = mediaItems.length;
            const current = swiper.realIndex + 1;
            counter.textContent = `${current} / ${total}`;
          }
        }

        // Показать стрелки, если слайдов больше 1
        if (navArrows)
          navArrows.style.display = mediaItems.length > 1 ? "flex" : "none";
        document
          .getElementById("navPrev")
          ?.addEventListener("click", () => currentSwiper?.slidePrev());
        document
          .getElementById("navNext")
          ?.addEventListener("click", () => currentSwiper?.slideNext());
      }

      // Инициализация зума для фото
      initZoom();
    } catch (err) {
      console.error(err);
      content.innerHTML =
        '<div style="margin:auto; color:#fff; text-align:center; padding:40px;">Не удалось загрузить пост.</div>';
    }
  }

  function resetZoom() {
    const activeSlide = document.querySelector(
      ".media-swiper .swiper-slide-active img",
    );
    if (activeSlide) {
      activeSlide.style.transform = "";
      activeSlide.parentElement?.classList.remove("zoomed");
      scale = 1;
    }
  }

  function initZoom() {
    const container = document.querySelector(".media-swiper");
    if (!container) return;

    let initialPinchDistance = 0;
    let initialScale = 1;

    // Двойной тап для зума
    container.addEventListener("dblclick", (e) => {
      const img = e.target.closest("img");
      if (!img) return;
      const slide = img.closest(".swiper-slide");
      if (!slide) return;
      if (slide.classList.contains("zoomed")) {
        img.style.transform = "";
        slide.classList.remove("zoomed");
        scale = 1;
      } else {
        img.style.transform = "scale(2)";
        slide.classList.add("zoomed");
        scale = 2;
      }
    });

    // Pinch-zoom (тачпад и сенсор)
    container.addEventListener("touchstart", (e) => {
      if (e.touches.length === 2) {
        initialPinchDistance = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );
        initialScale = scale;
      }
    });

    container.addEventListener("touchmove", (e) => {
      if (e.touches.length === 2 && initialPinchDistance > 0) {
        e.preventDefault();
        const currentDistance = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );
        const newScale = Math.min(
          Math.max(initialScale * (currentDistance / initialPinchDistance), 1),
          3,
        );
        const img = container.querySelector(".swiper-slide-active img");
        if (img) {
          img.style.transform = `scale(${newScale})`;
          scale = newScale;
          const slide = img.closest(".swiper-slide");
          if (newScale > 1) slide?.classList.add("zoomed");
          else slide?.classList.remove("zoomed");
        }
      }
    });

    container.addEventListener("touchend", () => {
      initialPinchDistance = 0;
    });

    // Колесо мыши для зума (с Ctrl)
    container.addEventListener(
      "wheel",
      (e) => {
        if (e.ctrlKey) {
          e.preventDefault();
          const img = container.querySelector(".swiper-slide-active img");
          if (!img) return;
          const delta = e.deltaY > 0 ? -0.1 : 0.1;
          const newScale = Math.min(Math.max(scale + delta, 1), 3);
          img.style.transform = `scale(${newScale})`;
          scale = newScale;
          const slide = img.closest(".swiper-slide");
          if (newScale > 1) slide?.classList.add("zoomed");
          else slide?.classList.remove("zoomed");
        }
      },
      { passive: false },
    );
  }

  // Закрытие модалки (крестик, оверлей, Escape, свайп вниз)
  function closeModal() {
    const modal = document.getElementById("postModal");
    if (!modal) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    destroySwiper();
  }

  document.getElementById("modalClose")?.addEventListener("click", closeModal);
  document.getElementById("postModal")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    const modal = document.getElementById("postModal");
    if (e.key === "Escape" && modal?.classList.contains("open")) {
      closeModal();
    }
  });

  // Свайп вниз для закрытия
  let touchStartY = 0;
  let touchCurrentY = 0;
  let isSwiping = false;

  document.addEventListener("touchstart", (e) => {
    if (e.touches.length === 1) {
      touchStartY = e.touches[0].clientY;
      isSwiping = true;
    }
  });

  document.addEventListener("touchmove", (e) => {
    if (!isSwiping) return;
    touchCurrentY = e.touches[0].clientY;
    const diff = touchCurrentY - touchStartY;
    const container = document.querySelector(".modal-container");
    if (container && diff > 0) {
      container.style.transform = `translateY(${diff}px)`;
      container.style.opacity = 1 - diff / window.innerHeight;
    }
  });

  document.addEventListener("touchend", () => {
    if (!isSwiping) return;
    isSwiping = false;
    const diff = touchCurrentY - touchStartY;
    const container = document.querySelector(".modal-container");
    if (container && diff > 100) {
      closeModal();
    } else if (container) {
      container.style.transform = "";
      container.style.opacity = "";
    }
    touchStartY = 0;
    touchCurrentY = 0;
  });

  window.openPostModal = openPostModal;
</script>
