---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      ×
    </button>

    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;

    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(12px);

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .modal-container {
    position: relative;

    width: 100vw;
    height: 100vh;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    background: #050505;
  }

  .modal-content {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
  }

  .modal-close {
    position: absolute;
    top: 18px;
    right: 20px;

    z-index: 50;

    width: 46px;
    height: 46px;

    border: none;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.08);

    color: #fff;

    font-size: 30px;
    line-height: 1;

    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: scale(1.05);
  }

  .modal-spinner {
    width: 42px;
    height: 42px;

    border: 3px solid rgba(255, 255, 255, 0.15);
    border-top-color: var(--accent);

    border-radius: 50%;

    margin: auto;

    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* =========================
     SWIPER
  ========================== */

  .media-carousel {
    position: relative;

    width: 100%;
    height: 100%;

    flex: 1;
    min-height: 0;
  }

  .media-swiper {
    width: 100%;
    height: 100%;
  }

  .media-swiper .swiper-wrapper {
    align-items: center;
  }

  .media-swiper .swiper-slide {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #000;
  }

  .media-swiper img {
    width: 100%;
    height: 100%;

    object-fit: contain;

    user-select: none;
    -webkit-user-drag: none;
  }

  .video-wrapper {
    width: 100%;
    height: 100%;
  }

  .video-wrapper iframe {
    width: 100%;
    height: 100%;

    border: none;
  }

  /* =========================
     POST INFO
  ========================== */

  .post-info {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 20;

    padding: 80px 40px 40px;

    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92),
      rgba(0, 0, 0, 0.55),
      transparent
    );

    pointer-events: none;
  }

  .post-date {
    color: var(--accent);

    font-size: 14px;
    font-weight: 700;

    margin-bottom: 12px;

    text-transform: uppercase;
    letter-spacing: 0.5px;

    opacity: 0.95;
  }

  .post-text {
    color: #fff;

    font-size: 1rem;
    line-height: 1.7;

    max-width: 900px;

    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
  }

  /* =========================
     NAVIGATION
  ========================== */

  .swiper-button-next,
  .swiper-button-prev {
    width: 54px;
    height: 54px;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(10px);

    color: #fff;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .swiper-button-next:hover,
  .swiper-button-prev:hover {
    transform: scale(1.08);
    background: rgba(255, 255, 255, 0.15);
  }

  .swiper-button-next::after,
  .swiper-button-prev::after {
    font-size: 20px;
    font-weight: 700;
  }

  .swiper-pagination {
    bottom: 18px !important;
  }

  .swiper-pagination-bullet {
    background: rgba(255, 255, 255, 0.45);
    opacity: 1;
  }

  .swiper-pagination-bullet-active {
    background: var(--accent);
  }

  /* =========================
     MOBILE
  ========================== */

  @media (max-width: 768px) {
    .post-info {
      padding: 70px 20px 24px;
    }

    .post-text {
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .swiper-button-next,
    .swiper-button-prev {
      width: 44px;
      height: 44px;
    }

    .swiper-button-next::after,
    .swiper-button-prev::after {
      font-size: 16px;
    }

    .modal-close {
      width: 42px;
      height: 42px;

      font-size: 26px;
    }
  }
</style>

<script lang="js">
  /** @type {any|null} */
  let currentSwiper = null;

  function destroySwiper() {
    if (currentSwiper) {
      currentSwiper.destroy(true, true);
      currentSwiper = null;
    }
  }

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById("postModal");
    const content = document.getElementById("modalContent");

    if (!modal || !content) return;

    destroySwiper();

    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    content.innerHTML = `
      <div class="modal-spinner"></div>
    `;

    const isLocal =
      location.hostname === "localhost" || location.hostname === "127.0.0.1";

    try {
      let post = null;

      if (isLocal && window.VK_ACCESS_TOKEN_FOR_DEV) {
        const token = window.VK_ACCESS_TOKEN_FOR_DEV;

        const res = await fetch(
          `https://api.vk.com/method/wall.getById?posts=${ownerId}_${postId}&access_token=${token}&v=5.131`,
        );

        const data = await res.json();

        if (data.error) {
          throw new Error(data.error.error_msg);
        }

        post = data.response?.[0] ?? null;
      } else {
        const res = await fetch(
          `/api/get-post?owner_id=${ownerId}&post_id=${postId}`,
        );

        if (!res.ok) {
          throw new Error("Ошибка загрузки");
        }

        post = await res.json();
      }

      if (!post) {
        throw new Error("Пост не найден");
      }

      const mediaItems =
        post.attachments?.filter(
          (att) => att.type === "photo" || att.type === "video",
        ) || [];

      const date = new Date(post.date * 1000);

      const formattedDate = date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });

      const slides = mediaItems
        .map((att) => {
          if (att.type === "photo" && att.photo) {
            const img =
              att.photo.sizes.find((s) => s.type === "w") ||
              att.photo.sizes[att.photo.sizes.length - 1];

            return `
              <div class="swiper-slide">
                <img
                  src="${img.url}"
                  alt="Фото"
                  loading="lazy"
                />
              </div>
            `;
          }

          if (att.type === "video" && att.video) {
            const video = att.video;

            const iframeSrc =
              `https://vk.com/video_ext.php?oid=${video.owner_id}` +
              `&id=${video.id}` +
              `&hash=${video.access_key || ""}` +
              `&hd=2` +
              `&autoplay=0` +
              `&js_api=1` +
              `&disable_related_videos=1`;

            return `
              <div class="swiper-slide">
                <div class="video-wrapper">
                  <iframe
                    src="${iframeSrc}"
                    allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                    allowfullscreen
                    referrerpolicy="no-referrer"
                  ></iframe>
                </div>
              </div>
            `;
          }

          return "";
        })
        .join("");

      let docsHtml = "";

      const docs = post.attachments?.filter((att) => att.type === "doc") || [];

      if (docs.length > 0) {
        docsHtml = `
          <div style="
            position:absolute;
            top:20px;
            left:20px;
            z-index:30;
            display:flex;
            flex-direction:column;
            gap:10px;
          ">
            ${docs
              .map((att) => {
                if (!att.doc) return "";

                return `
                  <a
                    href="${att.doc.url}"
                    target="_blank"
                    rel="noopener"
                    style="
                      padding:10px 14px;
                      border-radius:12px;
                      background:rgba(255,255,255,.08);
                      color:#fff;
                      text-decoration:none;
                      backdrop-filter:blur(10px);
                      border:1px solid rgba(255,255,255,.08);
                    "
                  >
                    📄 ${att.doc.title}
                  </a>
                `;
              })
              .join("")}
          </div>
        `;
      }

      content.innerHTML = `
        <div class="media-carousel">
          <div class="swiper media-swiper">
            <div class="swiper-wrapper">
              ${slides}
            </div>

            <div class="swiper-pagination"></div>

            ${
              mediaItems.length > 1
                ? `
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                `
                : ""
            }
          </div>

          ${docsHtml}

          <div class="post-info">
            <div class="post-date">
              ${formattedDate}
            </div>

            ${
              post.text
                ? `
                  <div class="post-text">
                    ${post.text.replace(/\n/g, "<br>")}
                  </div>
                `
                : ""
            }
          </div>
        </div>
      `;

      if (mediaItems.length > 0 && typeof Swiper !== "undefined") {
        currentSwiper = new Swiper(".media-swiper", {
          loop: mediaItems.length > 1,

          speed: 700,

          centeredSlides: true,

          preloadImages: false,

          watchOverflow: true,

          autoHeight: false,

          grabCursor: true,

          keyboard: {
            enabled: true,
          },

          mousewheel: true,

          pagination: {
            el: ".swiper-pagination",
            clickable: true,
          },

          navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
          },
        });
      }
    } catch (err) {
      console.error(err);

      content.innerHTML = `
        <div style="
          margin:auto;
          color:white;
          text-align:center;
          padding:40px;
        ">
          Не удалось загрузить пост.
        </div>
      `;
    }
  }

  function closeModal() {
    const modal = document.getElementById("postModal");

    if (!modal) return;

    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";

    destroySwiper();
  }

  document.getElementById("modalClose")?.addEventListener("click", closeModal);

  document.getElementById("postModal")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    const modal = document.getElementById("postModal");

    if (e.key === "Escape" && modal?.classList.contains("open")) {
      closeModal();
    }
  });

  window.openPostModal = openPostModal;
</script>
