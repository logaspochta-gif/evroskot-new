---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <button
      class="modal-close"
      id="modalClose"
      aria-label="Закрыть"
    >
      ×
    </button>

    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>
  </div>
</div>

<style>
  /* ... стили без изменений ... */
</style>

<script>
  let currentSwiper: typeof Swiper | null = null;

  function destroySwiper(): void {
    if (currentSwiper) {
      currentSwiper.destroy(true, true);
      currentSwiper = null;
    }
  }

  async function openPostModal(ownerId: string, postId: string): Promise<void> {
    const modal = document.getElementById('postModal');
    const content = document.getElementById('modalContent');

    if (!modal || !content) return;

    destroySwiper();

    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');

    document.body.style.overflow = 'hidden';

    content.innerHTML = `
      <div class="modal-spinner"></div>
    `;

    const isLocal =
      location.hostname === 'localhost' ||
      location.hostname === '127.0.0.1';

    try {
      let post: any;

      if (isLocal && window.VK_ACCESS_TOKEN_FOR_DEV) {
        const token = window.VK_ACCESS_TOKEN_FOR_DEV;

        const res = await fetch(
          `https://api.vk.com/method/wall.getById?posts=${ownerId}_${postId}&access_token=${token}&v=5.131`
        );

        const data = await res.json();

        if (data.error) {
          throw new Error(data.error.error_msg);
        }

        post = data.response?.[0];
      } else {
        const res = await fetch(
          `/api/get-post?owner_id=${ownerId}&post_id=${postId}`
        );

        if (!res.ok) {
          throw new Error('Ошибка загрузки');
        }

        post = await res.json();
      }

      if (!post) {
        throw new Error('Пост не найден');
      }

      const mediaItems =
        post.attachments?.filter(
          (att: any) =>
            att.type === 'photo' ||
            att.type === 'video'
        ) || [];

      const date = new Date(post.date * 1000);

      const formattedDate =
        date.toLocaleDateString('ru-RU', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });

      const slides = mediaItems.map((att: any) => {
        if (att.type === 'photo') {
          const img =
            att.photo.sizes.find((s: any) => s.type === 'w') ||
            att.photo.sizes[att.photo.sizes.length - 1];

          return `
            <div class="swiper-slide">
              <img
                src="${img.url}"
                alt="Фото"
                loading="lazy"
              />
            </div>
          `;
        }

        if (att.type === 'video') {
          const video = att.video;

          const iframeSrc =
            `https://vk.com/video_ext.php?oid=${video.owner_id}` +
            `&id=${video.id}` +
            `&hash=${video.access_key || ''}` +
            `&hd=2` +
            `&autoplay=0` +
            `&js_api=1` +
            `&disable_related_videos=1`;

          return `
            <div class="swiper-slide">
              <div class="video-wrapper">
                <iframe
                  src="${iframeSrc}"
                  allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                  allowfullscreen
                  referrerpolicy="no-referrer"
                ></iframe>
              </div>
            </div>
          `;
        }

        return '';
      }).join('');

      let docsHtml = '';

      const docs =
        post.attachments?.filter(
          (att: any) => att.type === 'doc'
        ) || [];

      if (docs.length > 0) {
        docsHtml = `
          <div style="
            position:absolute;
            top:20px;
            left:20px;
            z-index:30;
            display:flex;
            flex-direction:column;
            gap:10px;
          ">
            ${docs.map((att: any) => `
              <a
                href="${att.doc.url}"
                target="_blank"
                rel="noopener"
                style="
                  padding:10px 14px;
                  border-radius:12px;
                  background:rgba(255,255,255,.08);
                  color:#fff;
                  text-decoration:none;
                  backdrop-filter:blur(10px);
                  border:1px solid rgba(255,255,255,.08);
                "
              >
                📄 ${att.doc.title}
              </a>
            `).join('')}
          </div>
        `;
      }

      content.innerHTML = `
        <div class="media-carousel">
          <div class="swiper media-swiper">
            <div class="swiper-wrapper">
              ${slides}
            </div>

            <div class="swiper-pagination"></div>

            ${
              mediaItems.length > 1
                ? `
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                `
                : ''
            }
          </div>

          ${docsHtml}

          <div class="post-info">
            <div class="post-date">
              ${formattedDate}
            </div>

            ${
              post.text
                ? `
                  <div class="post-text">
                    ${post.text.replace(/\n/g, '<br>')}
                  </div>
                `
                : ''
            }
          </div>
        </div>
      `;

      if (
        mediaItems.length > 0 &&
        typeof Swiper !== 'undefined'
      ) {
        currentSwiper = new Swiper('.media-swiper', {
          loop: mediaItems.length > 1,

          speed: 700,

          centeredSlides: true,

          preloadImages: false,

          watchOverflow: true,

          autoHeight: false,

          grabCursor: true,

          keyboard: {
            enabled: true,
          },

          mousewheel: true,

          pagination: {
            el: '.swiper-pagination',
            clickable: true,
          },

          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
        });
      }
    } catch (err) {
      console.error(err);

      content.innerHTML = `
        <div style="
          margin:auto;
          color:white;
          text-align:center;
          padding:40px;
        ">
          Не удалось загрузить пост.
        </div>
      `;
    }
  }

  function closeModal(): void {
    const modal = document.getElementById('postModal');

    if (!modal) return;

    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');

    document.body.style.overflow = '';

    destroySwiper();
  }

  document
    .getElementById('modalClose')
    ?.addEventListener('click', closeModal);

  document
    .getElementById('postModal')
    ?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
        closeModal();
      }
    });

  document.addEventListener('keydown', (e) => {
    const modal = document.getElementById('postModal');

    if (
      e.key === 'Escape' &&
      modal?.classList.contains('open')
    ) {
      closeModal();
    }
  });

  window.openPostModal = openPostModal;
</script>