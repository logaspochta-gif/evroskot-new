---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="slide-counter" id="slideCounter"></div>

    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>

    <div class="nav-arrows" id="navArrows" style="display:none">
      <button class="nav-arrow nav-prev" id="navPrev" aria-label="Предыдущий">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <button class="nav-arrow nav-next" id="navNext" aria-label="Следующий">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </div>

    <div class="post-info" id="postInfo" style="display:none"></div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s, visibility 0.25s;
  }
  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .modal-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: #000;
  }
  .modal-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 60;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: transform 0.2s, background 0.2s;
  }
  .modal-close:hover {
    background: rgba(255, 255, 255, 0.24);
    transform: scale(1.05);
  }
  .slide-counter {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  .nav-arrows {
    position: absolute;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    pointer-events: none;
  }
  .nav-arrow {
    width: 52px;
    height: 52px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: transform 0.2s, background 0.2s;
  }
  .nav-arrow:hover {
    transform: scale(1.06);
    background: rgba(255, 255, 255, 0.26);
  }
  .post-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 90px 40px 40px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.94),
      rgba(0, 0, 0, 0.45),
      transparent
    );
    pointer-events: none;
    color: #fff;
  }
  .post-date {
    margin-bottom: 10px;
    color: var(--accent, #10b981);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .post-text {
    max-width: 900px;
    font-size: 0.96rem;
    line-height: 1.65;
    opacity: 0.92;
  }
  .modal-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid rgba(255, 255, 255, 0.15);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Swiper только для фото */
  .photo-swiper {
    width: 100%;
    height: 100%;
  }
  .photo-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    overflow: hidden;
  }
  .photo-swiper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  .swiper-pagination {
    bottom: 20px !important;
  }
  .swiper-pagination-bullet {
    background: rgba(255, 255, 255, 0.5);
    opacity: 1;
  }
  .swiper-pagination-bullet-active {
    background: var(--accent, #10b981);
  }

  /* Полноэкранный видео-слой */
  .video-fullscreen {
    position: absolute;
    inset: 0;
    z-index: 70;
    background: #000;
  }
  .video-fullscreen iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Кнопка просмотра видео */
  .video-play-btn {
    position: absolute;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    padding: 12px 24px;
    background: var(--accent, #10b981);
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    border: none;
    transition: background 0.2s;
  }
  .video-play-btn:hover {
    background: var(--accent-hover, #059669);
  }

  @media (max-width: 768px) {
    .modal-close {
      width: 42px;
      height: 42px;
      top: 14px;
      right: 14px;
    }
    .nav-arrow {
      width: 44px;
      height: 44px;
    }
    .post-info {
      padding: 70px 20px 22px;
    }
    .post-text {
      font-size: 0.88rem;
      line-height: 1.55;
    }
  }
</style>

<script lang="js">
  let photoSwiper = null;

  function destroySwiper() {
    if (photoSwiper) {
      photoSwiper.destroy(true, true);
      photoSwiper = null;
    }
  }

  function pauseAllVideos() {
    document.querySelectorAll('.video-fullscreen iframe').forEach(el => {
      // Просто удаляем слой, останавливая видео
      el.remove();
    });
  }

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById('postModal');
    const content = document.getElementById('modalContent');
    const counter = document.getElementById('slideCounter');
    const navArrows = document.getElementById('navArrows');
    const info = document.getElementById('postInfo');

    if (!modal || !content) return;

    destroySwiper();
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    content.innerHTML = '<div class="modal-spinner"></div>';
    if (counter) counter.textContent = '';
    if (navArrows) navArrows.style.display = 'none';
    if (info) info.style.display = 'none';

    try {
      const res = await fetch(`/api/get-post?owner_id=${ownerId}&post_id=${postId}`);
      if (!res.ok) throw new Error('Ошибка загрузки');
      const post = await res.json();
      if (!post) throw new Error('Пост не найден');

      const photos = post.attachments?.filter(a => a.type === 'photo') || [];
      const videos = post.attachments?.filter(a => a.type === 'video') || [];
      const date = new Date(post.date * 1000);
      const formattedDate = date.toLocaleDateString('ru-RU', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });

      // === ТОЛЬКО ФОТО (Swiper) ===
      if (photos.length > 0) {
        const slides = photos.map((att, i) => {
          const img = att.photo.sizes.find(s => s.type === 'x') || att.photo.sizes[att.photo.sizes.length - 1];
          return `<div class="swiper-slide"><img src="${img.url}" alt="Фото ${i + 1}" loading="lazy" /></div>`;
        }).join('');

        content.innerHTML = `
          <div class="swiper photo-swiper">
            <div class="swiper-wrapper">${slides}</div>
            <div class="swiper-pagination"></div>
          </div>
        `;

        if (typeof Swiper !== 'undefined') {
          photoSwiper = new Swiper('.photo-swiper', {
            loop: false,
            pagination: { el: '.swiper-pagination', clickable: true },
            grabCursor: true,
            keyboard: true,
          });
        }

        if (counter) counter.textContent = `${1} / ${photos.length}`;
        if (navArrows) navArrows.style.display = photos.length > 1 ? 'flex' : 'none';

        if (photoSwiper) {
          photoSwiper.on('slideChange', function () {
            if (counter) counter.textContent = `${this.realIndex + 1} / ${photos.length}`;
          });
        }

        document.getElementById('navPrev')?.addEventListener('click', () => photoSwiper?.slidePrev());
        document.getElementById('navNext')?.addEventListener('click', () => photoSwiper?.slideNext());
      }

      // === ВИДЕО – отдельный полноэкранный слой ===
      if (videos.length > 0) {
        // Берем первое видео (можно расширить до всех, добавив плеер)
        const v = videos[0].video;
        const videoSrc = `https://vk.com/video_ext.php?oid=${v.owner_id}&id=${v.id}&hash=${v.access_key || ''}&hd=2&autoplay=1&js_api=1&disable_related_videos=1`;

        // Если нет фото, сразу показываем видео
        if (photos.length === 0) {
          content.innerHTML = `
            <div class="video-fullscreen">
              <iframe src="${videoSrc}" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>
            </div>
          `;
        } else {
          // Если есть фото, добавляем кнопку поверх
          const videoBtn = document.createElement('button');
          videoBtn.className = 'video-play-btn';
          videoBtn.textContent = '▶ Смотреть видео';
          videoBtn.addEventListener('click', () => {
            // Останавливаем Swiper
            destroySwiper();
            // Заменяем содержимое на полноэкранный iframe
            content.innerHTML = `
              <div class="video-fullscreen">
                <iframe src="${videoSrc}" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>
              </div>
            `;
          });
          modal.querySelector('.modal-container').appendChild(videoBtn);
        }
      }

      // === ИНФО (дата и текст) ===
      if (info) {
        info.innerHTML = `
          <div class="post-date">${formattedDate}</div>
          ${post.text ? `<div class="post-text">${post.text.replace(/\n/g, '<br>')}</div>` : ''}
        `;
        info.style.display = 'block';
      }

    } catch (e) {
      console.error(e);
      content.innerHTML = '<div style="color:#fff; text-align:center; padding:40px;">Не удалось загрузить пост</div>';
    }
  }

  function closeModal() {
    const modal = document.getElementById('postModal');
    if (!modal) return;
    if (document.activeElement && modal.contains(document.activeElement)) {
      document.activeElement.blur();
    }
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    destroySwiper();
    // Удаляем кнопки видео, если остались
    const triggers = modal.querySelectorAll('.video-play-btn');
    triggers.forEach(t => t.remove());
    // Останавливаем видео (удаляем слой)
    const fullscreen = modal.querySelector('.video-fullscreen');
    if (fullscreen) fullscreen.remove();
  }

  document.getElementById('modalClose')?.addEventListener('click', closeModal);
  document.getElementById('postModal')?.addEventListener('click', e => {
    if (e.target === e.currentTarget) closeModal();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && document.getElementById('postModal')?.classList.contains('open')) {
      closeModal();
    }
  });

  window.openPostModal = openPostModal;
</script>