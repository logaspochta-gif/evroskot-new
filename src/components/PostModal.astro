---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>

    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.96);
    backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }
  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .modal-container {
    width: 100vw;
    height: 100vh;
    background: #000;
    position: relative;
    overflow: hidden;
  }
  .modal-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 60;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }
  .modal-close:hover { background: rgba(255,255,255,0.25); }
  .modal-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid rgba(255,255,255,0.15);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Swiper */
  .media-swiper {
    width: 100%;
    height: 100%;
  }
  .media-swiper .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    overflow: hidden;
  }
  .media-swiper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  .video-wrapper {
    width: 100%;
    height: 100%;
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
  .swiper-pagination { bottom: 20px !important; }
  .swiper-pagination-bullet { background: rgba(255,255,255,0.5); }
  .swiper-pagination-bullet-active { background: var(--accent); }
</style>

<script>
  let swiper = null;

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById('postModal');
    const content = document.getElementById('modalContent');
    if (!modal || !content) return;

    if (swiper) { swiper.destroy(true, true); swiper = null; }

    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    content.innerHTML = '<div class="modal-spinner"></div>';

    try {
      const res = await fetch(`/api/get-post?owner_id=${ownerId}&post_id=${postId}`);
      if (!res.ok) throw new Error('Ошибка загрузки');
      const post = await res.json();
      if (!post) throw new Error('Пост не найден');

      const mediaItems = post.attachments?.filter(a => a.type === 'photo' || a.type === 'video') || [];

      const slides = mediaItems.map((att, i) => {
        if (att.type === 'photo' && att.photo) {
          const img = att.photo.sizes.find(s => s.type === 'x') || att.photo.sizes[att.photo.sizes.length-1];
          return `<div class="swiper-slide"><img src="${img.url}" alt="Фото ${i+1}" loading="lazy" /></div>`;
        }
        if (att.type === 'video' && att.video) {
          const v = att.video;
          const src = `https://vk.com/video_ext.php?oid=${v.owner_id}&id=${v.id}&hash=${v.access_key||''}&hd=2&autoplay=0&js_api=1&disable_related_videos=1`;
          return `<div class="swiper-slide"><div class="video-wrapper"><iframe src="${src}" allowfullscreen allow="autoplay; encrypted-media; fullscreen; picture-in-picture"></iframe></div></div>`;
        }
        return '';
      }).join('');

      content.innerHTML = `
        <div class="swiper media-swiper">
          <div class="swiper-wrapper">${slides}</div>
          <div class="swiper-pagination"></div>
        </div>
      `;

      if (mediaItems.length > 0 && typeof Swiper !== 'undefined') {
        swiper = new Swiper('.media-swiper', {
          loop: false,
          pagination: { el: '.swiper-pagination', clickable: true },
          grabCursor: true,
          keyboard: true,
        });
      }
    } catch (e) {
      console.error(e);
      content.innerHTML = '<div style="color:#fff; text-align:center; padding:40px;">Не удалось загрузить пост</div>';
    }
  }

  function closeModal() {
    const modal = document.getElementById('postModal');
    if (!modal) return;
    if (document.activeElement && modal.contains(document.activeElement)) {
      (document.activeElement).blur();
    }
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (swiper) { swiper.destroy(true, true); swiper = null; }
  }

  document.getElementById('modalClose')?.addEventListener('click', closeModal);
  document.getElementById('postModal')?.addEventListener('click', e => {
    if (e.target === e.currentTarget) closeModal();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && document.getElementById('postModal')?.classList.contains('open')) closeModal();
  });

  window.openPostModal = openPostModal;
</script>