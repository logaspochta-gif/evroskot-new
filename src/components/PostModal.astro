---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <!-- CLOSE -->
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>

    <!-- COUNTER -->
    <div class="slide-counter" id="slideCounter"></div>

    <!-- CONTENT -->
    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>

    <!-- NAVIGATION -->
    <div class="nav-arrows" id="navArrows" style="display:none">
      <button class="nav-arrow nav-prev" id="navPrev" aria-label="Предыдущий">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button class="nav-arrow nav-next" id="navNext" aria-label="Следующий">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- POST INFO -->
    <div class="post-info" id="postInfo" style="display:none"></div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;

    background: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(18px);

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .modal-container {
    position: relative;

    width: 100vw;
    height: 100vh;

    overflow: hidden;

    background: #000;

    transform: translateY(0);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }

  .modal-content {
    width: 100%;
    height: 100%;

    min-width: 0;
    min-height: 0;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;

    z-index: 60;

    width: 48px;
    height: 48px;

    border: none;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.12);

    color: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    backdrop-filter: blur(10px);

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.24);
    transform: scale(1.05);
  }

  .slide-counter {
    position: absolute;
    top: 24px;
    left: 50%;

    transform: translateX(-50%);

    z-index: 60;

    padding: 7px 16px;

    border-radius: 999px;

    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);

    color: #fff;

    font-size: 13px;
    font-weight: 600;

    letter-spacing: 0.5px;
  }

  .nav-arrows {
    position: absolute;

    inset: 0;

    z-index: 50;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 20px;

    pointer-events: none;
  }

  .nav-arrow {
    width: 52px;
    height: 52px;

    border: none;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);

    color: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    pointer-events: auto;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .nav-arrow:hover {
    transform: scale(1.06);
    background: rgba(255, 255, 255, 0.26);
  }

  .post-info {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 40;

    padding: 90px 40px 40px;

    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.94),
      rgba(0, 0, 0, 0.45),
      transparent
    );

    pointer-events: none;

    color: #fff;
  }

  .post-date {
    margin-bottom: 10px;

    color: var(--accent, #10b981);

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .post-text {
    max-width: 900px;

    font-size: 0.96rem;
    line-height: 1.65;

    opacity: 0.92;
  }

  .modal-spinner {
    width: 48px;
    height: 48px;

    border: 4px solid rgba(255, 255, 255, 0.14);
    border-top-color: var(--accent);

    border-radius: 50%;

    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* =========================================
     SWIPER
  ========================================= */

  .media-carousel,
  .media-swiper,
  .media-swiper .swiper-wrapper,
  .media-swiper .swiper-slide {
    width: 100%;
    height: 100%;

    min-width: 0;
    min-height: 0;
  }

  .media-carousel {
    position: relative;
  }

  .media-swiper .swiper-slide {
    position: relative;

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #000;
  }

  /* IMAGE */

  .media-swiper img {
    width: 100%;
    height: 100%;

    object-fit: contain;

    user-select: none;
    -webkit-user-drag: none;

    will-change: transform;
    transition: transform 0.25s ease;
  }

  .media-swiper .swiper-slide.zoomed img {
    cursor: grab;
  }

  /* VIDEO */

  .video-wrapper {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #000;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;

    width: 100vw;
    height: 100vh;

    border: 0;

    background: #000;
  }

  .swiper-pagination {
    bottom: 18px !important;
  }

  .swiper-pagination-bullet {
    background: rgba(255, 255, 255, 0.5);
    opacity: 1;
  }

  .swiper-pagination-bullet-active {
    background: var(--accent, #10b981);
  }

  /* MOBILE */

  @media (max-width: 768px) {
    .modal-close {
      width: 42px;
      height: 42px;

      top: 14px;
      right: 14px;
    }

    .nav-arrow {
      width: 44px;
      height: 44px;
    }

    .post-info {
      padding: 70px 20px 22px;
    }

    .post-text {
      font-size: 0.88rem;
      line-height: 1.55;
    }
  }
</style>

<script lang="js">
  // @ts-nocheck

  /** @type {import('swiper').Swiper | null} */
  let currentSwiper = null;

  let scale = 1;

  let zoomInitialized = false;

  function destroySwiper() {
    if (currentSwiper) {
      currentSwiper.destroy(true, true);
      currentSwiper = null;
    }
  }

  function resetZoom() {
    const img = document.querySelector(
      ".media-swiper .swiper-slide-active img",
    );

    if (!img) return;

    img.style.transform = "scale(1)";

    const slide = img.closest(".swiper-slide");

    slide?.classList.remove("zoomed");

    scale = 1;
  }

  function initZoom() {
    if (zoomInitialized) return;

    zoomInitialized = true;

    const container = document.body;

    let initialDistance = 0;
    let initialScale = 1;

    container.addEventListener("dblclick", (e) => {
      const img = e.target.closest("img");

      if (!img) return;

      const slide = img.closest(".swiper-slide");

      if (!slide) return;

      if (slide.classList.contains("zoomed")) {
        img.style.transform = "scale(1)";
        slide.classList.remove("zoomed");
        scale = 1;
      } else {
        img.style.transform = "scale(2)";
        slide.classList.add("zoomed");
        scale = 2;
      }
    });

    container.addEventListener(
      "touchmove",
      (e) => {
        if (e.touches.length !== 2) return;

        e.preventDefault();

        const img = document.querySelector(
          ".media-swiper .swiper-slide-active img",
        );

        if (!img) return;

        const currentDistance = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );

        if (!initialDistance) {
          initialDistance = currentDistance;
          initialScale = scale;
          return;
        }

        const nextScale = Math.min(
          Math.max(initialScale * (currentDistance / initialDistance), 1),
          3,
        );

        img.style.transform = `scale(${nextScale})`;

        scale = nextScale;

        const slide = img.closest(".swiper-slide");

        if (nextScale > 1) {
          slide?.classList.add("zoomed");
        } else {
          slide?.classList.remove("zoomed");
        }
      },
      { passive: false },
    );

    container.addEventListener("touchend", () => {
      initialDistance = 0;
    });
  }

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById("postModal");
    const content = document.getElementById("modalContent");
    const counter = document.getElementById("slideCounter");
    const navArrows = document.getElementById("navArrows");
    const info = document.getElementById("postInfo");

    if (!modal || !content) return;

    destroySwiper();

    modal.classList.add("open");

    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    content.innerHTML = `
      <div class="modal-spinner"></div>
    `;

    if (counter) counter.textContent = "";

    if (navArrows) {
      navArrows.style.display = "none";
    }

    if (info) {
      info.style.display = "none";
    }

    const isLocal =
      location.hostname === "localhost" || location.hostname === "127.0.0.1";

    try {
      let post = null;

      if (isLocal && window.VK_ACCESS_TOKEN_FOR_DEV) {
        const res = await fetch(
          `https://api.vk.com/method/wall.getById?posts=${ownerId}_${postId}&access_token=${window.VK_ACCESS_TOKEN_FOR_DEV}&v=5.131`,
        );

        const data = await res.json();

        if (data.error) {
          throw new Error(data.error.error_msg);
        }

        post = data.response?.[0] ?? null;
      } else {
        const res = await fetch(
          `/api/get-post?owner_id=${ownerId}&post_id=${postId}`,
        );

        if (!res.ok) {
          throw new Error("Ошибка загрузки");
        }

        post = await res.json();
      }

      if (!post) {
        throw new Error("Пост не найден");
      }

      const mediaItems =
        post.attachments?.filter(
          (att) => att.type === "photo" || att.type === "video",
        ) || [];

      const date = new Date(post.date * 1000);

      const formattedDate = date.toLocaleDateString("ru-RU", {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });

      const slides = mediaItems
        .map((att, idx) => {
          if (att.type === "photo" && att.photo) {
            const img =
              att.photo.sizes.find((s) => s.type === "w") ||
              att.photo.sizes[att.photo.sizes.length - 1];

            return `
              <div class="swiper-slide" data-type="photo">
                <img
                  src="${img.url}"
                  alt="Фото ${idx + 1}"
                  loading="lazy"
                />
              </div>
            `;
          }

          if (att.type === "video" && att.video) {
            const video = att.video;

            const iframeSrc =
              `https://vk.com/video_ext.php?oid=${video.owner_id}` +
              `&id=${video.id}` +
              `&hash=${video.access_key || ""}` +
              `&hd=2` +
              `&autoplay=0` +
              `&js_api=1` +
              `&disable_related_videos=1`;

            return `
              <div class="swiper-slide" data-type="video">
                <div class="video-wrapper">
                  <iframe
                    src="${iframeSrc}"
                    allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                    allowfullscreen
                    referrerpolicy="no-referrer"
                  ></iframe>
                </div>
              </div>
            `;
          }

          return "";
        })
        .join("");

      content.innerHTML = `
        <div class="media-carousel">
          <div class="swiper media-swiper">
            <div class="swiper-wrapper">
              ${slides}
            </div>

            <div class="swiper-pagination"></div>
          </div>
        </div>
      `;

      if (info) {
        info.innerHTML = `
          <div class="post-date">
            ${formattedDate}
          </div>

          ${
            post.text
              ? `
                <div class="post-text">
                  ${post.text.replace(/\n/g, "<br>")}
                </div>
              `
              : ""
          }
        `;

        info.style.display = "block";
      }

      if (mediaItems.length > 0 && typeof Swiper !== "undefined") {
        currentSwiper = new Swiper(".media-swiper", {
          loop: false,

          speed: 350,

          spaceBetween: 0,

          centeredSlides: true,

          autoHeight: false,

          preloadImages: false,

          watchOverflow: true,

          grabCursor: true,

          keyboard: {
            enabled: true,
            onlyInViewport: true,
          },

          pagination: {
            el: ".swiper-pagination",
            clickable: true,
          },

          navigation: {
            nextEl: ".nav-next",
            prevEl: ".nav-prev",
          },

          on: {
            init(swiper) {
              updateCounter(swiper);
            },

            slideChange(swiper) {
              updateCounter(swiper);
              resetZoom();
            },
          },
        });

        requestAnimationFrame(() => {
          currentSwiper?.update();
          currentSwiper?.updateSize();
          currentSwiper?.updateSlides();
        });

        function updateCounter(swiper) {
          if (!counter) return;

          counter.textContent = `${swiper.realIndex + 1} / ${mediaItems.length}`;
        }

        if (navArrows) {
          navArrows.style.display = mediaItems.length > 1 ? "flex" : "none";
        }
      }

      initZoom();
    } catch (err) {
      console.error(err);

      content.innerHTML = `
        <div style="
          margin:auto;
          color:#fff;
          text-align:center;
          padding:40px;
        ">
          Не удалось загрузить пост.
        </div>
      `;
    }
  }

  function closeModal() {
    const modal = document.getElementById("postModal");

    if (!modal) return;

    modal.classList.remove("open");

    modal.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";

    destroySwiper();

    resetZoom();
  }

  document.getElementById("modalClose")?.addEventListener("click", closeModal);

  document.getElementById("postModal")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) {
      closeModal();
    }
  });

  document.getElementById("navPrev")?.addEventListener("click", () => {
    currentSwiper?.slidePrev();
  });

  document.getElementById("navNext")?.addEventListener("click", () => {
    currentSwiper?.slideNext();
  });

  document.addEventListener("keydown", (e) => {
    const modal = document.getElementById("postModal");

    if (e.key === "Escape" && modal?.classList.contains("open")) {
      closeModal();
    }
  });

  // SWIPE DOWN TO CLOSE

  let touchStartY = 0;
  let touchCurrentY = 0;
  let isSwiping = false;

  document.addEventListener("touchstart", (e) => {
    const modal = document.getElementById("postModal");

    if (!modal?.classList.contains("open")) return;

    if (e.touches.length === 1) {
      touchStartY = e.touches[0].clientY;
      isSwiping = true;
    }
  });

  document.addEventListener("touchmove", (e) => {
    if (!isSwiping) return;

    touchCurrentY = e.touches[0].clientY;

    const diff = touchCurrentY - touchStartY;

    const container = document.querySelector(".modal-container");

    if (container && diff > 0) {
      container.style.transform = `translateY(${diff}px)`;

      container.style.opacity = `${1 - diff / window.innerHeight}`;
    }
  });

  document.addEventListener("touchend", () => {
    if (!isSwiping) return;

    isSwiping = false;

    const diff = touchCurrentY - touchStartY;

    const container = document.querySelector(".modal-container");

    if (container && diff > 120) {
      closeModal();
    } else if (container) {
      container.style.transform = "";
      container.style.opacity = "";
    }

    touchStartY = 0;
    touchCurrentY = 0;
  });

  window.openPostModal = openPostModal;
</script>
