---
// src/components/PostModal.astro
---

<div
  class="modal-overlay"
  id="postModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="modal-container">
    <button class="modal-close" id="modalClose" aria-label="Закрыть">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>

    <div class="slide-counter" id="slideCounter"></div>

    <div class="modal-content" id="modalContent">
      <div class="modal-spinner"></div>
    </div>

    <div class="nav-arrows" id="navArrows" style="display:none">
      <button class="nav-arrow nav-prev" id="navPrev" aria-label="Предыдущий">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="nav-arrow nav-next" id="navNext" aria-label="Следующий">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="post-info" id="postInfo" style="display:none"></div>
  </div>
</div>

<style is:global>
  :root {
    --modal-bg: rgba(0, 0, 0, 0.7);
    --modal-blur: 18px;
    --modal-transition: 0.25s ease;
    --modal-radius: 50%;
    --modal-accent: var(--accent, #10b981);
    --modal-text: #fff;
    --modal-muted: rgba(255, 255, 255, 0.7);
  }

  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--modal-bg);
    backdrop-filter: blur(var(--modal-blur));
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--modal-transition), visibility var(--modal-transition);
  }
  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .modal-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    background: transparent;
  }
  .modal-content {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }

  .simple-slider {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .simple-slider .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .simple-slider .slide.active {
    opacity: 1;
    visibility: visible;
  }
  .simple-slider .slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    will-change: transform;
  }

  .video-wrapper {
    position: absolute;
    inset: 0;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .video-wrapper video,
  .video-wrapper iframe {
    width: 100% !important;
    height: 100% !important;
    border: none;
    object-fit: contain;
    aspect-ratio: auto !important;
  }

  .video-facade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background-size: cover;
    background-position: center;
    background-color: #000;
  }
  .video-play-btn {
    background: rgba(0, 0, 0, 0.7);
    border: 3px solid #fff;
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, background 0.25s ease;
    z-index: 2;
  }
  .video-play-btn::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    border-left: 24px solid #fff;
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
    margin-left: 6px;
  }
  .video-play-btn:hover {
    transform: scale(1.1);
    background: var(--modal-accent);
  }

  .nav-arrows {
    position: absolute;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    pointer-events: none;
  }
  .nav-arrow {
    width: 52px;
    height: 52px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .nav-arrow:hover {
    transform: scale(1.06);
    background: rgba(255, 255, 255, 0.26);
  }
  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 60;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .modal-close:hover {
    background: rgba(255, 255, 255, 0.24);
    transform: scale(1.05);
  }
  .slide-counter {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }
  .post-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 90px 40px 40px;
    background: linear-gradient(to top, rgba(0,0,0,0.94), rgba(0,0,0,0.45), transparent);
    pointer-events: none;
    color: #fff;
  }
  .post-date {
    margin-bottom: 10px;
    color: var(--modal-accent);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .post-text {
    max-width: 900px;
    font-size: 0.96rem;
    line-height: 1.65;
    opacity: 0.92;
  }

  @media (max-width: 768px) {
    .modal-close { width: 42px; height: 42px; top: 14px; right: 14px; }
    .nav-arrow { width: 44px; height: 44px; }
    .post-info { padding: 70px 20px 22px; }
    .post-text { font-size: 0.88rem; line-height: 1.55; }
    .slide-counter { font-size: 12px; padding: 5px 12px; }
    .modal-overlay { background: rgba(0, 0, 0, 0.55); }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-overlay, .modal-close, .nav-arrow, .simple-slider .slide { transition: none; }
    .nav-arrow:hover, .modal-close:hover { transform: none; }
  }
</style>

<script>
  // @ts-nocheck
  declare var Hls: any;

  let currentSlideIndex = 0, totalSlides = 0, scale = 1, zoomInitialized = false;
  const mediaLoaded = new Set<number>();

  function log(msg, data) {
    console.log(`[PostModal] ${msg}`, data !== undefined ? data : '');
  }

  function destroyPlayer() {
    document.querySelectorAll('.simple-slider video, .simple-slider iframe').forEach(el => {
      if (el instanceof HTMLVideoElement) { el.pause(); el.src = ''; }
      else if (el instanceof HTMLIFrameElement) { el.src = ''; }
    });
    mediaLoaded.clear();
  }

  function resetZoom() {
    const img = document.querySelector(".simple-slider .slide.active img");
    if (!img) return;
    img.style.transform = "scale(1)";
    img.closest(".slide")?.classList.remove("zoomed");
    scale = 1;
  }

  function initZoom() {
    if (zoomInitialized) return;
    zoomInitialized = true;
    let initialDistance = 0, initialScale = 1;

    document.body.addEventListener("dblclick", (e) => {
      const img = e.target.closest("img");
      if (!img) return;
      const slide = img.closest(".slide");
      if (!slide) return;
      const zoomed = slide.classList.contains("zoomed");
      img.style.transform = zoomed ? "scale(1)" : "scale(2)";
      slide.classList.toggle("zoomed");
      scale = zoomed ? 1 : 2;
    });

    document.body.addEventListener("touchmove", (e) => {
      if (e.touches.length !== 2) return;
      e.preventDefault();
      const img = document.querySelector(".simple-slider .slide.active img");
      if (!img) return;
      const d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      if (!initialDistance) { initialDistance = d; initialScale = scale; return; }
      const ns = Math.min(Math.max(initialScale * (d / initialDistance), 1), 3);
      img.style.transform = `scale(${ns})`;
      scale = ns;
      img.closest(".slide")?.classList.toggle("zoomed", ns > 1);
    }, { passive: false });

    document.body.addEventListener("touchend", () => { initialDistance = 0; });
  }

  function goToSlide(index) {
    const slides = document.querySelectorAll(".simple-slider .slide");
    if (!slides.length) return;
    const prev = slides[currentSlideIndex];
    if (prev) {
      const v = prev.querySelector('video'), f = prev.querySelector('iframe');
      if (v) { v.pause(); v.src = ''; }
      if (f) f.src = '';
    }
    slides.forEach(s => s.classList.remove("active"));
    slides[index].classList.add("active");
    currentSlideIndex = index;
    document.getElementById("slideCounter").textContent = `${index + 1} / ${totalSlides}`;
    resetZoom();
    loadSlideContent(index);
  }

  function nextSlide() { if (totalSlides > 1) goToSlide((currentSlideIndex + 1) % totalSlides); }
  function prevSlide() { if (totalSlides > 1) goToSlide((currentSlideIndex - 1 + totalSlides) % totalSlides); }

  function loadSlideContent(index) {
    if (mediaLoaded.has(index)) return;
    const slide = document.querySelectorAll(".simple-slider .slide")[index];
    if (!slide) return;
    const img = slide.querySelector('img');
    if (img?.dataset.src && !img.src.startsWith('http')) img.src = img.dataset.src;
    const facade = slide.querySelector('.video-facade');
    if (!facade) return;
    const { videoUrl, videoType, poster } = facade.dataset;
    let html = '';
    if (videoType === 'hls') html = `<div class="video-wrapper" data-hls="${videoUrl}"><video controls playsinline preload="metadata" controlsList="nodownload" poster="${poster}"></video></div>`;
    else if (videoType === 'mp4') html = `<div class="video-wrapper"><video src="${videoUrl}" controls playsinline preload="metadata" controlsList="nodownload" poster="${poster}"></video></div>`;
    else if (videoType === 'vk_iframe') html = `<div class="video-wrapper"><iframe src="${videoUrl}" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="no-referrer"></iframe></div>`;
    facade.outerHTML = html;
    mediaLoaded.add(index);
    if (videoType === 'hls' && typeof Hls !== "undefined") {
      const v = slide.querySelector('video');
      if (v) { const h = new Hls(); h.loadSource(videoUrl); h.attachMedia(v); }
    }
  }

  async function openPostModal(ownerId, postId) {
    const modal = document.getElementById("postModal"), content = document.getElementById("modalContent");
    if (!modal || !content) return;
    destroyPlayer();
    modal.classList.add("open"); modal.setAttribute("aria-hidden", "false");
    document.documentElement.style.overflow = "hidden";
    content.innerHTML = '<div class="modal-spinner"></div>';
    document.getElementById("slideCounter").textContent = "";
    document.getElementById("navArrows").style.display = "none";
    document.getElementById("postInfo").style.display = "none";

    const isLocal = location.hostname === "localhost" || location.hostname === "127.0.0.1";
    try {
      let post = null;
      if (isLocal && window.VK_ACCESS_TOKEN_FOR_DEV) {
        const r = await fetch(`https://api.vk.com/method/wall.getById?posts=${ownerId}_${postId}&access_token=${window.VK_ACCESS_TOKEN_FOR_DEV}&v=5.131`);
        const d = await r.json(); if (d.error) throw new Error(d.error.error_msg);
        post = d.response?.[0] ?? null;
      } else {
        const r = await fetch(`/api/get-post?owner_id=${ownerId}&post_id=${postId}`);
        if (!r.ok) throw new Error("Ошибка загрузки");
        post = await r.json();
      }
      if (!post) throw new Error("Пост не найден");

      const date = new Date(post.date * 1000);
      const fmtDate = date.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" });
      const mediaItems = (post.attachments || []).filter(a => /photo|video|link|doc/.test(a.type));
      totalSlides = mediaItems.length;

      const slides = await Promise.all(mediaItems.map(async (att, idx) => {
        if (att.type === "photo" && att.photo) {
          const u = att.photo.sizes.find(s => s.type === "w")?.url || att.photo.sizes.slice(-1)[0]?.url;
          return `<div class="slide ${idx === 0 ? 'active' : ''}" data-type="photo"><img src="${idx === 0 ? u : 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg"%3E%3C/svg%3E'}" data-src="${u}" alt="Фото ${idx+1}" loading="${idx === 0 ? 'eager' : 'lazy'}" decoding="async" /></div>`;
        }
        if (att.type === "video" && att.video) {
          const v = att.video, accessKey = v.access_key || '';
          let vd = null;
          try { const r = await fetch(`/api/get-video?owner_id=${v.owner_id}&video_id=${v.id}&access_key=${accessKey}`); if (r.ok) vd = await r.json(); } catch(e) {}
          const poster = vd?.poster || '';
          const makeSlide = (body, isActive) => `<div class="slide ${isActive ? 'active' : ''}" data-type="video">${body}</div>`;
          if (vd?.hls || vd?.mp4) {
            if (idx === 0) {
              const t = vd.hls ? 'hls' : 'mp4';
              const body = vd.hls ? `<div class="video-wrapper" data-hls="${vd.hls}"><video controls playsinline preload="metadata" controlsList="nodownload" poster="${poster}"></video></div>`
                : `<div class="video-wrapper"><video src="${vd.mp4}" controls playsinline preload="metadata" controlsList="nodownload" poster="${poster}"></video></div>`;
              return makeSlide(body, true);
            }
            const url = vd.hls || vd.mp4;
            return makeSlide(`<div class="video-facade" style="background-image: url(${poster})" data-video-url="${url}" data-video-type="${vd.hls ? 'hls' : 'mp4'}" data-poster="${poster}"><div class="video-play-btn"></div></div>`, false);
          }
          const iframeSrc = `https://vk.com/video_ext.php?oid=${v.owner_id}&id=${v.id}&hash=${accessKey}&hd=2&autoplay=0&js_api=1&disable_related_videos=1`;
          if (idx === 0) return makeSlide(`<div class="video-wrapper"><iframe src="${iframeSrc}" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="no-referrer"></iframe></div>`, true);
          return makeSlide(`<div class="video-facade" style="background-image: url(${poster})" data-video-url="${iframeSrc}" data-video-type="vk_iframe"><div class="video-play-btn"></div></div>`, false);
        }
        if (att.type === "link" && att.link) {
          const l = att.link, img = l.photo?.sizes?.length ? `<img src="${l.photo.sizes.slice(-1)[0].url}" alt="" />` : '';
          return `<div class="slide ${idx === 0 ? 'active' : ''}" data-type="link"><div class="link-preview">${img}<div class="preview-title">${l.title || "Ссылка"}</div>${l.description ? `<div class="preview-description">${l.description}</div>` : ''}<a href="${l.url}" target="_blank" rel="noopener" class="preview-button">Открыть</a></div></div>`;
        }
        if (att.type === "doc" && att.doc) {
          const d = att.doc;
          return `<div class="slide ${idx === 0 ? 'active' : ''}" data-type="doc"><div class="doc-preview"><div class="preview-title">${d.title || "Документ"}</div><a href="${d.url}" target="_blank" rel="noopener" class="preview-button">Скачать / Открыть</a></div></div>`;
        }
        return "";
      }));

      content.innerHTML = `<div class="simple-slider">${slides.join("")}</div>`;
      document.getElementById("postInfo").innerHTML = `<div class="post-date">${fmtDate}</div>${post.text ? `<div class="post-text">${post.text.replace(/\n/g, "<br>")}</div>` : ""}`;
      document.getElementById("postInfo").style.display = "block";

      currentSlideIndex = 0; mediaLoaded.clear();
      if (document.querySelector(".simple-slider .slide.active video, .simple-slider .slide.active iframe")) mediaLoaded.add(0);
      if (typeof Hls !== "undefined") {
        const firstVideo = document.querySelector(".simple-slider .slide.active video");
        const wrap = firstVideo?.closest('.video-wrapper');
        if (wrap?.dataset.hls) { const h = new Hls(); h.loadSource(wrap.dataset.hls); h.attachMedia(firstVideo); }
      }

      document.getElementById("navPrev").onclick = prevSlide;
      document.getElementById("navNext").onclick = nextSlide;
      document.getElementById("navArrows").style.display = totalSlides > 1 ? "flex" : "none";

      document.getElementById("modalContent")?.addEventListener('click', (e) => {
        const btn = e.target.closest('.video-play-btn');
        if (!btn) return;
        const facade = btn.closest('.video-facade');
        if (!facade) return;
        const slide = facade.closest('.slide');
        const idx = Array.from(document.querySelectorAll('.simple-slider .slide')).indexOf(slide);
        if (idx >= 0 && !mediaLoaded.has(idx)) loadSlideContent(idx);
      });

      initZoom();
    } catch (err) {
      log('Ошибка', err);
      content.innerHTML = '<div style="color:#fff; text-align:center; padding:40px;">Не удалось загрузить пост</div>';
    }
  }

  function closeModal() {
    const modal = document.getElementById("postModal");
    if (!modal) return;
    if (document.activeElement && modal.contains(document.activeElement)) document.activeElement.blur();
    modal.classList.remove("open"); modal.setAttribute("aria-hidden", "true");
    document.documentElement.style.overflow = "";
    destroyPlayer();
    document.getElementById("modalContent").innerHTML = "";
  }

  document.getElementById("modalClose")?.addEventListener("click", closeModal);
  document.getElementById("postModal")?.addEventListener("click", (e) => { if (e.target === e.currentTarget) closeModal(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && document.getElementById("postModal")?.classList.contains("open")) closeModal(); });

  let touchStartY = 0, touchCurrentY = 0, isSwiping = false;
  document.addEventListener("touchstart", (e) => {
    if (!document.getElementById("postModal")?.classList.contains("open")) return;
    if (e.touches.length === 1) { touchStartY = e.touches[0].clientY; isSwiping = true; }
  });
  document.addEventListener("touchmove", (e) => {
    if (!isSwiping) return;
    touchCurrentY = e.touches[0].clientY;
    const diff = touchCurrentY - touchStartY;
    const container = document.querySelector(".modal-container");
    if (container && diff > 0) {
      container.style.transform = `translateY(${diff}px)`;
      container.style.opacity = String(1 - diff / window.innerHeight);
    }
  });
  document.addEventListener("touchend", () => {
    if (!isSwiping) return;
    isSwiping = false;
    const diff = touchCurrentY - touchStartY;
    const container = document.querySelector(".modal-container");
    if (container && diff > 120) closeModal();
    else if (container) { container.style.transform = ""; container.style.opacity = ""; }
    touchStartY = 0; touchCurrentY = 0;
  });

  window.openPostModal = openPostModal;
</script>