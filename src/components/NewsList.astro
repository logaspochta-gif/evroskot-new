---
// src/components/NewsList.astro
export interface Props {
  items: {
    title: string;
    link: string;
    pubDate: string;
    content: string;
    image: string | null;
    isoDate: string;
    size?: 'small' | 'large' | 'wide';
    ownerId?: number;
    postId?: number;
  }[];
  emptyMessage?: string;
}

const { items, emptyMessage = 'Новостей пока нет.' } = Astro.props;
const hasItems = items.length > 0;
---

<section class="news-list-section" aria-labelledby="news-heading">
  <div class="news-list-container">
    <div class="section-header">
      <span class="section-badge">Новости</span>
      <h2 id="news-heading" class="section-title">
        Последние <span class="accent">события</span>
      </h2>
    </div>

    {hasItems ? (
      <div class="news-grid">
        {items.map((item) => (
          <article
            class={`news-card ${item.size || 'small'}`}
            content-visibility="auto"
          >
            <a
              href={item.link}
              data-owner-id={item.ownerId}
              data-post-id={item.postId}
              class="card-link"
              aria-label={`Открыть новость: ${item.title}`}
            >
              {item.image ? (
                <div class="card-image-wrapper">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="card-image"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                </div>
              ) : (
                <div class="card-image-placeholder" aria-hidden="true">
                  <span>Scanova A/S</span>
                </div>
              )}

              <div class="card-body">
                <time class="card-date" datetime={item.isoDate}>
                  {item.pubDate}
                </time>
                <!-- Заголовок выводится всегда -->
                <h3 class="card-title">{item.title || 'Без названия'}</h3>
                {item.content && <p class="card-text">{item.content}</p>}
              </div>

              <span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-message">{emptyMessage}</p>
      </div>
    )}
  </div>
</section>

<style>
  :root {
    --news-radius: 24px;
  }

  .news-list-section {
    position: relative;
    padding: clamp(100px, 10vw, 140px) 5% clamp(80px, 8vw, 120px);
    background: radial-gradient(circle at top, rgba(16,185,129,0.05), transparent 35%), var(--dark);
    overflow: hidden;
  }

  .news-list-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 70px);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(16,185,129,0.35);
    background: rgba(16,185,129,0.08);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1.2rem;
  }

  .section-title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    font-weight: 900;
    color: #fff;
    text-wrap: balance;
  }

  .accent { color: var(--accent); }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    gap: clamp(20px, 3vw, 32px);
    align-items: stretch;
  }

  .news-card {
    position: relative;
    border-radius: var(--news-radius);
    contain: layout paint style;
    content-visibility: auto;
    contain-intrinsic-size: 220px;
  }

  .news-card.large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .news-card.wide {
    grid-column: span 2;
  }

  .card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--news-radius);
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    backdrop-filter: blur(14px);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    will-change: transform;
  }

  .card-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top, rgba(16,185,129,0.08), transparent 65%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .card-link:hover,
  .card-link:focus-visible {
    transform: translateY(-6px);
    border-color: rgba(16,185,129,0.35);
    box-shadow: 0 18px 40px rgba(0,0,0,0.35);
  }

  .card-link:hover::before,
  .card-link:focus-visible::before {
    opacity: 1;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .card-image-wrapper,
  .card-image-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255,255,255,0.03);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 0.45s ease;
  }

  .card-link:hover .card-image {
    transform: scale(1.04);
  }

  .card-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    font-weight: 700;
    letter-spacing: 2px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 22px 24px;
  }

  .card-date {
    display: inline-block;
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card-title {
    margin: 0 0 0.9rem;
    color: #fff;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.35;
    font-weight: 800;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-text {
    margin: 0;
    color: rgba(255,255,255,0.72);
    font-size: 0.96rem;
    line-height: 1.7;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-arrow {
    position: absolute;
    top: 18px;
    right: 20px;
    color: var(--accent);
    font-size: 1.4rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .card-link:hover .card-arrow,
  .card-link:focus-visible .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .empty-state {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 240px;
    border-radius: 28px;
    border: 1px dashed rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02);
  }

  .empty-message {
    margin: 0;
    color: rgba(255,255,255,0.65);
    font-size: 1.05rem;
    text-align: center;
  }

  @media (max-width: 992px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 280px;
    }
    .news-card.large,
    .news-card.wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .news-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .news-card {
      min-height: 300px;
    }
    .card-body {
      padding: 18px 18px 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>