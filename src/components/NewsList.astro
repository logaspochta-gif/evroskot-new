---
// src/components/NewsList.astro
export interface Props {
  items: {
    title: string;
    link: string;
    pubDate: string;
    content: string;
    image: string | null;
    isoDate: string;
    size?: 'small' | 'large' | 'wide';
    ownerId?: number;
    postId?: number;
  }[];
  emptyMessage?: string;
}

const { items, emptyMessage = 'Новостей пока нет.' } = Astro.props;
const hasItems = items.length > 0;
---

<section class="news-list-section" aria-labelledby="news-heading">
  <div class="news-list-container">
    <div class="section-header">
      <span class="section-badge">Новости</span>
      <h2 id="news-heading" class="section-title">
        Последние <span class="accent">события</span>
      </h2>
    </div>

    {hasItems ? (
      <div class="news-grid">
        {items.map((item) => (
          <article class={`news-card ${item.size || 'small'}`}>
            <a
              href={item.link}
              data-owner-id={item.ownerId}
              data-post-id={item.postId}
              class="card-link"
              aria-label={`Открыть новость: ${item.title}`}
              data-astro-prefetch="hover"
            >
              {item.image ? (
                <div
                  class="card-bg-image"
                  style={`background-image: url(${item.image})`}
                ></div>
              ) : (
                <div class="card-placeholder" aria-hidden="true">
                  <span>Scanova A/S</span>
                </div>
              )}

              <div class="card-overlay"></div>

              <div class="card-content">
                <h3 class="card-title">{item.title || 'Без названия'}</h3>
                <time class="card-date" datetime={item.isoDate}>
                  {item.pubDate}
                </time>
              </div>

              <span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-message">{emptyMessage}</p>
      </div>
    )}
  </div>
</section>

<style>
  .news-list-section {
    --news-section-gap: clamp(20px, 3vw, 32px);
    --news-section-radius: 24px;
    --news-section-card-bg: var(--card-bg, #141414);
    --news-section-border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    --news-section-accent: var(--accent, #10b981);
    --news-section-text: #fff;
    --news-section-muted: rgba(255, 255, 255, 0.7);
    --news-section-transition: 0.3s ease;

    position: relative;
    padding: clamp(100px, 10vw, 140px) 5% clamp(80px, 8vw, 120px);
    background: radial-gradient(circle at top, rgba(16,185,129,0.05), transparent 35%), var(--dark);
    overflow: hidden;
  }

  .news-list-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 70px);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(16,185,129,0.35);
    background: rgba(16,185,129,0.08);
    color: var(--news-section-accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1.2rem;
  }

  .section-title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    font-weight: 900;
    color: var(--news-section-text);
    text-wrap: balance;
  }

  .accent { color: var(--news-section-accent); }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 260px;
    gap: var(--news-section-gap);
    align-items: stretch;
  }

  .news-card.large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .news-card.wide {
    grid-column: span 2;
    grid-row: span 1;
  }

  .news-card {
    position: relative;
    border-radius: var(--news-section-radius);
    transition: transform var(--news-section-transition);
    height: 100%;
    min-height: 220px;
  }

  .card-link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--news-section-radius);
    overflow: hidden;
    border: var(--news-section-border);
    text-decoration: none;
    color: inherit;
    transition: transform var(--news-section-transition), border-color var(--news-section-transition), box-shadow var(--news-section-transition);
    will-change: transform;
  }

  .card-link:hover {
    transform: translateY(-6px);
    border-color: rgba(16,185,129,0.35);
    box-shadow: 0 18px 40px rgba(0,0,0,0.35);
  }

  .card-link:focus-visible {
    outline: 2px solid var(--news-section-accent);
    outline-offset: 4px;
  }

  .card-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9), rgba(0,0,0,0.2));
    z-index: 2;
  }

  .card-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--news-section-card-bg);
    color: rgba(255,255,255,0.3);
    font-weight: 700;
    letter-spacing: 2px;
    z-index: 1;
  }

  .card-content {
    position: relative;
    z-index: 3;
    margin-top: auto;
    padding: 16px 16px 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card-title {
    margin: 0 0 0.4rem;
    color: var(--news-section-text);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    line-height: 1.3;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    display: block;
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--news-section-accent);
  }

  .card-arrow {
    position: absolute;
    top: 14px;
    right: 16px;
    color: var(--news-section-accent);
    font-size: 1.3rem;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--news-section-transition), transform var(--news-section-transition);
    z-index: 4;
  }

  .card-link:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .empty-state {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 240px;
    border-radius: 28px;
    border: 1px dashed rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02);
  }

  .empty-message {
    margin: 0;
    color: rgba(255,255,255,0.65);
    font-size: 1.05rem;
    text-align: center;
  }

  @media (max-width: 992px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 240px;
    }
    .news-card.large,
    .news-card.wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .news-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .news-card {
      min-height: 280px;
    }
    .card-content {
      padding: 14px 14px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card {
      transition: none;
    }
    .card-link:hover {
      transform: none;
    }
  }
</style>