---
// src/components/Contact.astro
---

<section class="contact-section" id="contact">
  <div class="contact-container">
    <div class="section-header">
      <span class="section-badge">Контакты</span>
      <h2 class="section-title">
        Связаться <span class="accent">с нами</span>
      </h2>
      <p class="section-subtitle">
        Оставьте заявку - мы подготовим индивидуальное коммерческое предложение.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Контактная информация -->
      <div class="contact-info">
        <article class="info-card">
          <h3 class="card-title">
            <svg
              class="card-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.32 1.76.59 2.6a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.48-1.16a2 2 0 0 1 2.11-.45c.84.27 1.71.47 2.6.59A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            Контакты
          </h3>
          <div class="info-item">
            <span class="info-label">Представитель в России</span>
            <a href="tel:+79236540951">+7 923 654 09 51 - Антон</a>
          </div>
          <div class="info-item">
            <span class="info-label">Поставщик в Дании</span>
            <a href="tel:+4553283429">+45 53 28 34 29 - Михаил Матвеевич</a>
          </div>
          <div class="info-item">
            <span class="info-label">Email</span>
            <a href="mailto:scanova@scanova.info">scanova@scanova.info</a>
          </div>
        </article>
      </div>

      <!-- Форма -->
      <div class="contact-form-wrapper">
        <div class="contact-form-glow" aria-hidden="true"></div>
        <form id="contactForm" class="contact-form" method="POST" novalidate>
          <h3 class="card-title">
            <svg
              class="card-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
              ></path>
              <polyline points="17 3 21 3 21 7"></polyline>
              <line x1="9" y1="15" x2="21" y2="3"></line>
            </svg>
            Оставить заявку
          </h3>

          <!-- Скрытое поле для защиты от спама -->
          <input
            type="text"
            name="_gotcha"
            class="hidden-field"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="form-group">
            <label for="name">Имя *</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              aria-describedby="name-error"
            />
            <span id="name-error" class="form-error" data-error="name"></span>
          </div>

          <div class="form-group">
            <label for="email">Email *</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              aria-describedby="email-error"
            />
            <span id="email-error" class="form-error" data-error="email"></span>
          </div>

          <div class="form-group">
            <label for="phone">Телефон</label>
            <input id="phone" name="phone" type="tel" />
          </div>

          <div class="form-group">
            <label for="message">Сообщение *</label>
            <textarea
              id="message"
              name="message"
              required
              aria-describedby="message-error"></textarea>
            <span id="message-error" class="form-error" data-error="message"
            ></span>
          </div>

          <div class="privacy-note">
            Отправляя форму, вы соглашаетесь с обработкой данных.
          </div>

          <button type="submit" id="submitBtn" class="submit-btn">
            <span class="btn-text">Отправить заявку</span>
            <svg class="spinner" viewBox="0 0 50 50" aria-hidden="true">
              <circle
                class="spinner-path"
                cx="25"
                cy="25"
                r="20"
                fill="none"
                stroke-width="4"></circle>
            </svg>
          </button>

          <div
            id="formSuccess"
            class="form-success"
            role="status"
            aria-live="polite"
            tabindex="-1"
          >
          </div>
          <div
            id="formError"
            class="form-global-error"
            role="alert"
            aria-live="assertive"
          >
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --danger: #ef4444;
  }

  .contact-section {
    --ctc-gap: clamp(30px, 5vw, 60px);
    --ctc-radius: 28px;
    --ctc-card-bg: rgba(20, 20, 20, 0.92);
    --ctc-border: 1px solid rgba(255, 255, 255, 0.08);
    --ctc-accent: var(--accent, #10b981);
    --ctc-text: #fff;
    --ctc-muted: rgba(255, 255, 255, 0.7);
    --ctc-transition: 0.25s ease;

    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(80px, 10vw, 140px) 5%;
    background:
      radial-gradient(circle at top, rgba(16, 185, 129, 0.08), transparent 35%),
      #0a0a0a;
    overflow: hidden;
    content-visibility: auto;
    contain-intrinsic-size: 1200px;
  }

  .contact-container {
    width: 100%;
    max-width: 1280px;
    z-index: 2;
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 70px);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.08);
    color: var(--ctc-accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .section-title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    line-height: 1.05;
    font-weight: 900;
    color: var(--ctc-text);
  }

  .accent {
    color: var(--ctc-accent);
  }

  .section-subtitle {
    max-width: 720px;
    margin: 1.2rem auto 0;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
    color: var(--ctc-muted);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--ctc-gap);
    align-items: stretch;
  }

  .info-card,
  .contact-form {
    position: relative;
    padding: clamp(24px, 4vw, 42px);
    border-radius: var(--ctc-radius);
    border: var(--ctc-border);
    background: var(--ctc-card-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    transition:
      transform var(--ctc-transition),
      border-color var(--ctc-transition),
      box-shadow var(--ctc-transition);
    will-change: transform;
  }

  @supports (backdrop-filter: blur(1px)) {
    .info-card,
    .contact-form {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.04),
        rgba(255, 255, 255, 0.015)
      );
      backdrop-filter: blur(16px);
    }
  }

  .info-card:hover,
  .contact-form:hover {
    border-color: var(--ctc-accent);
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0;
    margin-bottom: 2rem;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--ctc-text);
  }

  .card-icon {
    color: var(--ctc-accent);
    flex-shrink: 0;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.7rem;
  }

  .info-label {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: rgba(255, 255, 255, 0.5);
  }

  .info-item a {
    width: fit-content;
    color: var(--ctc-text);
    text-decoration: none;
    font-size: 1rem;
    transition:
      color var(--ctc-transition),
      transform var(--ctc-transition);
  }

  .info-item a:hover {
    color: var(--ctc-accent);
    transform: translateX(3px);
  }

  .contact-form-wrapper {
    position: relative;
  }

  .contact-form-glow {
    position: absolute;
    inset: -2px;
    border-radius: var(--ctc-radius);
    background: radial-gradient(
      circle at top,
      rgba(16, 185, 129, 0.22),
      transparent 70%
    );
    filter: blur(35px);
    opacity: 0.8;
    z-index: 0;
    pointer-events: none;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }

  .form-group input,
  .form-group textarea,
  .submit-btn {
    font-size: 16px; /* предотвращает масштабирование на iOS */
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: var(--ctc-text);
    font-family: inherit;
    transition:
      border-color var(--ctc-transition),
      box-shadow var(--ctc-transition),
      background var(--ctc-transition);
    box-sizing: border-box;
  }

  .form-group textarea {
    min-height: 140px;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: rgba(16, 185, 129, 0.6);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12);
  }

  .form-error {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.8rem;
    color: var(--danger);
  }

  .form-global-error {
    margin-top: 1rem;
    color: var(--danger);
    text-align: center;
    font-size: 0.92rem;
  }

  .form-success {
    margin-top: 1rem;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid rgba(16, 185, 129, 0.28);
    background: rgba(16, 185, 129, 0.08);
    color: var(--ctc-text);
    text-align: center;
    font-weight: 600;
    display: none;
  }

  .privacy-note {
    margin: 1.5rem 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.45);
  }

  .submit-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1rem 2rem;
    border: none;
    border-radius: 16px;
    background: var(--ctc-accent);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    will-change: transform;
    transition:
      transform var(--ctc-transition),
      background var(--ctc-transition),
      box-shadow var(--ctc-transition);
  }

  .submit-btn:hover {
    background: var(--accent-hover, #059669);
    transform: translateY(-2px);
  }

  .submit-btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .spinner {
    width: 18px;
    height: 18px;
    display: none;
    animation: rotate 1s linear infinite;
  }

  .submit-btn.loading .spinner {
    display: block;
  }

  .spinner-path {
    stroke: #fff;
    stroke-linecap: round;
  }

  @keyframes rotate {
    100% {
      transform: rotate(360deg);
    }
  }

  .hidden-field {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  @media (max-width: 920px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .info-card,
    .contact-form,
    .info-item a,
    .submit-btn {
      transition: none;
    }
    .info-card:hover,
    .contact-form:hover {
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const form = document.getElementById(
      "contactForm",
    ) as HTMLFormElement | null;
    if (!form) return;

    const endpoint = "/api/contact";
    const submitBtn = document.getElementById(
      "submitBtn",
    ) as HTMLButtonElement | null;
    const successBox = document.getElementById(
      "formSuccess",
    ) as HTMLDivElement | null;
    const errorBox = document.getElementById(
      "formError",
    ) as HTMLDivElement | null;
    const btnText = submitBtn?.querySelector(
      ".btn-text",
    ) as HTMLSpanElement | null;

    const fields = {
      name: document.getElementById("name") as HTMLInputElement | null,
      email: document.getElementById("email") as HTMLInputElement | null,
      message: document.getElementById("message") as HTMLTextAreaElement | null,
    };

    const errors = {
      name: document.querySelector(
        '[data-error="name"]',
      ) as HTMLSpanElement | null,
      email: document.querySelector(
        '[data-error="email"]',
      ) as HTMLSpanElement | null,
      message: document.querySelector(
        '[data-error="message"]',
      ) as HTMLSpanElement | null,
    };

    function setLoading(state: boolean): void {
      if (!submitBtn) return;
      submitBtn.disabled = state;
      submitBtn.classList.toggle("loading", state);
      if (btnText)
        btnText.textContent = state ? "Отправка..." : "Отправить заявку";
    }

    function validate(data: Record<string, string>): boolean {
      let ok = true;
      if (errors.name) errors.name.textContent = "";
      if (errors.email) errors.email.textContent = "";
      if (errors.message) errors.message.textContent = "";

      if (!data.name?.trim()) {
        if (errors.name) errors.name.textContent = "Введите имя";
        ok = false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || "")) {
        if (errors.email) errors.email.textContent = "Некорректный email";
        ok = false;
      }
      if ((data.message || "").trim().length < 10) {
        if (errors.message) errors.message.textContent = "Минимум 10 символов";
        ok = false;
      }
      return ok;
    }

    form.addEventListener("submit", async (e: Event) => {
      e.preventDefault();
      if (successBox) successBox.style.display = "none";
      if (errorBox) errorBox.textContent = "";

      const formData = new FormData(form);
      const data = Object.fromEntries(formData) as Record<string, string>;

      if (data._gotcha) return;
      if (!validate(data)) return;

      setLoading(true);

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            ...data,
            page: location.href,
            ts: Date.now(),
          }),
        });

        const json = await res.json();
        if (res.ok) {
          form.reset();
          if (successBox) {
            successBox.textContent = "Спасибо! Мы свяжемся с вами.";
            successBox.style.display = "block";
          }
        } else {
          if (errorBox) errorBox.textContent = json?.error || "Ошибка отправки";
        }
      } catch {
        if (errorBox)
          errorBox.textContent = "Сетевая ошибка. Попробуйте снова.";
      } finally {
        setLoading(false);
      }
    });
  })();
</script>
