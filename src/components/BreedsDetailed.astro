---
// src/components/BreedsDetailed.astro
import { Image } from "astro:assets";
import holsteinImg from "../assets/images/breeds/holstein.webp";
import jerseyImg from "../assets/images/breeds/jersey.webp";
import redDanishImg from "../assets/images/breeds/red-danish.webp";
import charolaisImg from "../assets/images/breeds/charolais.webp";
import aberdeenAngusImg from "../assets/images/breeds/aberdeen-angus.webp";
import herefordImg from "../assets/images/breeds/hereford.webp";
import limousinImg from "../assets/images/breeds/limousin.webp";
import simmentalImg from "../assets/images/breeds/simmental.webp";
---

<section class="breeds-section" id="breeds">
  <h2 class="section-title">Породы <span class="accent">крупного рогатого скота</span></h2>
  <p class="section-subtitle">Молочное и мясное направление. Только датская селекция.</p>

  <div class="splide breeds-splide" aria-label="Породы скота">
    <div class="splide__track">
      <ul class="splide__list">
        <!-- Голштинская -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={holsteinImg} alt="Голштинская порода" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Голштинская</h3>
              <p>Лидер по удоям молока. Чёрно-пёстрая масть. Выдающаяся генетика датской селекции.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Джерсейская -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={jerseyImg} alt="Джерсейская порода" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Джерсейская</h3>
              <p>Молоко с жирностью до 6%. Светло-коричневая масть. Компактное телосложение и долголетие.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Красная Датская -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={redDanishImg} alt="Красная Датская порода" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Красная Датская</h3>
              <p>Универсальная порода двойного назначения. Красно-пёстрая масть. Отличное здоровье и плодовитость.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Шароле -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={charolaisImg} alt="Шароле" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Шароле</h3>
              <p>Мясная порода с высокой энергией роста. Кремово-белая масть. Тяжёлые быки до 1 400 кг.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Абердин-Ангус -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={aberdeenAngusImg} alt="Абердин-Ангус" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Абердин-Ангус</h3>
              <p>Чёрная комолая порода. Мраморное мясо высшего качества. Лёгкость отёлов и скороспелость.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Герефордская -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={herefordImg} alt="Герефордская порода" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Герефордская</h3>
              <p>Красно-белая масть. Выносливость и неприхотливость. Отличная адаптация к пастбищному содержанию.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Лимузин -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={limousinImg} alt="Лимузин" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Лимузин</h3>
              <p>Золотисто-красная масть. Высокий выход постного мяса. Отличные материнские качества.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
        <!-- Симментальская -->
        <li class="splide__slide">
          <article class="breed-card">
            <Image src={simmentalImg} alt="Симментальская порода" loading="lazy" class="breed-image" />
            <div class="breed-body">
              <h3>Симментальская</h3>
              <p>Палево-пёстрая масть. Двойное назначение: молоко и мясо. Крепкая конституция и высокая продуктивность.</p>
              <span class="breed-link-text">Подробнее →</span>
            </div>
          </article>
        </li>
      </ul>
    </div>
    <div class="splide__arrows">
      <button class="splide__arrow splide__arrow--prev"></button>
      <button class="splide__arrow splide__arrow--next"></button>
    </div>
  </div>
</section>

<style>
  #breeds {
    scroll-margin-top: 100px; /* подберите под высоту вашего фиксированного меню */
  }

  .breeds-section {
    --breeds-radius: 28px;
    --breeds-card-bg: var(--card-bg, #141414);
    --breeds-border: 1px solid var(--border, rgba(255, 255, 255, 0.2));
    --breeds-text: #fff;
    --breeds-muted: rgba(255, 255, 255, 0.8);
    --breeds-accent: var(--accent, #10b981);
    --breeds-transition: 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);

    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(40px, 6vh, 80px) 2%;
    background: #000;
    overflow-x: clip;
  }

  .section-title {
    text-align: center;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 900;
    margin: 0 0 0.75rem;
    color: var(--breeds-text);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    text-align: center;
    color: var(--breeds-muted);
    margin-bottom: 3rem;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    max-width: 700px;
  }

  .accent { color: var(--breeds-accent); }

  .breeds-splide {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
  }

  .breed-card {
    background: var(--breeds-card-bg);
    border-radius: var(--breeds-radius);
    overflow: hidden;
    border: var(--breeds-border);
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.8);
    transition: transform var(--breeds-transition), box-shadow var(--breeds-transition), border-color var(--breeds-transition);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Стили для изображения, которое генерирует компонент Image */
  .breed-image {
    width: 100%;
    height: 55vh;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .breed-card:hover .breed-image {
    transform: scale(1.02);
  }

  .breed-body {
    padding: 24px 24px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
  }

  .breed-body h3 {
    font-size: 1.6rem;
    margin: 0;
    font-weight: 700;
    color: var(--breeds-text);
  }

  .breed-body p {
    margin: 0;
    color: var(--breeds-muted);
    line-height: 1.5;
    font-size: 0.95rem;
    flex: 1;
  }

  .breed-link-text {
    color: var(--breeds-accent);
    font-weight: 600;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    transition: gap 0.2s ease;
    cursor: pointer;
  }

  .breed-card:hover .breed-link-text {
    gap: 12px;
  }

  /* 3D эффект */
  .splide__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.5s ease;
    will-change: transform;
    transform: scale(0.85);
    opacity: 0.6;
  }

  .splide__slide.is-active {
    transform: scale(1.15);
    opacity: 1;
    z-index: 3;
  }

  .splide__slide.is-active .breed-card {
    box-shadow: 0 40px 70px rgba(0, 0, 0, 0.95);
  }

  .splide__slide.is-prev {
    transform: scale(0.85) rotateY(25deg) translateX(20%);
    opacity: 0.7;
    z-index: 2;
  }

  .splide__slide.is-next {
    transform: scale(0.85) rotateY(-25deg) translateX(-20%);
    opacity: 0.7;
    z-index: 2;
  }

  /* Стрелки Splide */
  :global(.breeds-splide .splide__arrow) {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s;
  }

  :global(.breeds-splide .splide__arrow:hover) {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
    border-color: var(--breeds-accent);
  }

  :global(.breeds-splide .splide__arrow svg) {
    fill: #fff;
    width: 24px;
    height: 24px;
  }

  @media (max-width: 1024px) {
    .breed-image {
      height: 45vh;
    }
    .breed-body h3 {
      font-size: 1.4rem;
    }
    .splide__slide.is-prev,
    .splide__slide.is-next {
      transform: scale(0.85) rotateY(15deg) translateX(10%);
    }
  }

  @media (max-width: 768px) {
    .breeds-section {
      padding: 40px 0;
    }
    .breed-image {
      height: 40vh;
    }
    .breed-body {
      padding: 20px 16px 24px;
    }
    .breed-body h3 {
      font-size: 1.2rem;
    }
    .breed-body p {
      font-size: 0.85rem;
    }
    .splide__slide {
      transform: scale(0.9);
    }
    .splide__slide.is-active {
      transform: scale(1.05);
    }
    .splide__slide.is-prev,
    .splide__slide.is-next {
      transform: scale(0.9) rotateY(0deg) translateX(0);
      opacity: 0.5;
    }
    :global(.breeds-splide .splide__arrow) {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  import Splide from '@splidejs/splide';

  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector('.breeds-splide');
    if (el instanceof HTMLElement) {
      new Splide(el, {
        type: 'loop',
        perPage: 2,
        perMove: 1,
        gap: 48,
        focus: 'center',
        padding: { left: '8%', right: '8%' },
        updateOnMove: true,
        waitForTransition: true,
        pagination: false,
        arrows: true,
        keyboard: 'global',
        breakpoints: {
          1024: {
            perPage: 1,
            gap: 0,
            padding: { left: '12%', right: '12%' },
          },
          768: {
            perPage: 1,
            padding: { left: '5%', right: '5%' },
          },
        },
      }).mount();
    }
  });
</script>