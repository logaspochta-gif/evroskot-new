---
// src/components/News.astro
export const prerender = false;

interface NewsItem {
  title: string;
  link: string;
  pubDate: string;
  content: string;
  image: string | null;
}

// Функция получения превью из вложения (фото или видео)
function getAttachmentPreview(attachments: any[]): string | null {
  if (!attachments?.length) return null;

  const first = attachments[0];

  // Фото
  if (first.photo?.sizes) {
    const sizes = first.photo.sizes;
    // Ищем 'x' (1280px) или самый большой доступный
    return sizes.find((s: any) => s.type === 'x')?.url ||
           sizes[sizes.length - 1]?.url ||
           null;
  }

  // Видео
  if (first.video?.image) {
    const images = first.video.image;
    // Берём самый большой размер (последний элемент)
    return images[images.length - 1]?.url || null;
  }

  return null;
}

const SERVICE_TOKEN = import.meta.env.VK_SERVICE_TOKEN;
const GROUP_ID = '99133048';
const API_VERSION = '5.131';

let news: NewsItem[] = [];

if (!SERVICE_TOKEN) {
  console.warn('VK_SERVICE_TOKEN не задан');
} else {
  try {
    const ownerId = -Math.abs(parseInt(GROUP_ID));
    const url = `https://api.vk.com/method/wall.get?owner_id=${ownerId}&count=10&access_token=${SERVICE_TOKEN}&v=${API_VERSION}`;
    const response = await fetch(url);
    const data = await response.json();

    if (!data.response) {
      const err = data.error?.error_msg || 'Ошибка API VK';
      throw new Error(err);
    }

    news = data.response.items.map((post: any) => {
      const image = getAttachmentPreview(post.attachments);
      return {
        title: post.text?.slice(0, 60) || 'Новость',
        link: `https://vk.com/wall${ownerId}_${post.id}`,
        pubDate: post.date
          ? new Date(post.date * 1000).toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          : 'Дата неизвестна',
        content: post.text?.slice(0, 120) || '',
        image,
      };
    });
  } catch (error) {
    console.error('Ошибка загрузки новостей:', error);
  }
}

// Лэйаут для первых 4 новостей
const LAYOUT = ['large', 'small', 'small', 'wide'];
const newsItems = news.slice(0, 4).map((item, idx) => ({
  ...item,
  size: LAYOUT[idx] || 'small',
}));
const hasNews = newsItems.length > 0;
---

<section id="news" class="news-section">
  <div class="news-container">
    <div class="section-header">
      <span class="badge">События</span>
      <h2 class="section-title">Новости <span class="accent">Scanova</span></h2>
    </div>

    {hasNews ? (
      <div class="bento-grid">
        {newsItems.map((item) => (
          <a
            href={item.link}
            target="_blank"
            rel="noopener noreferrer"
            class={`news-card ${item.size}`}
          >
            {item.image && (
              <img
                src={item.image}
                alt=""
                class="card-bg-image"
                loading="lazy"
              />
            )}
            <div class="card-overlay"></div>
            <div class="card-content">
              <span class="date">{item.pubDate}</span>
              <h3>{item.title}</h3>
              <p>{item.content}</p>
            </div>
            <div class="card-arrow">→</div>
          </a>
        ))}
      </div>
    ) : (
      <p class="news-placeholder">Новости пока не загружены.</p>
    )}

    <div class="more-news">
      <a href="https://vk.com/evroskot" target="_blank" rel="noopener" class="secondary-btn">
        Все новости ВКонтакте
      </a>
    </div>
  </div>
</section>

<style>
  .news-section {
    padding: 120px 5% 80px;
    background: var(--dark);
  }
  .news-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.5);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1.5rem;
    color: #fff;
  }
  .section-title {
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0;
  }
  .accent {
    color: var(--accent, #10b981);
  }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: 20px;
  }
  .news-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: var(--card-bg, #1a1a1a);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid var(--border, rgba(255,255,255,0.1));
    transition: all 0.4s ease;
  }
  .news-card:hover {
    border-color: var(--accent, #10b981);
    transform: translateY(-5px);
  }
  .card-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    z-index: 2;
  }
  .card-content {
    position: relative;
    z-index: 3;
    padding: 30px;
  }
  .date {
    font-size: 0.7rem;
    color: var(--accent, #10b981);
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  h3 {
    font-size: 1.2rem;
    margin: 10px 0;
    line-height: 1.3;
    color: #fff;
  }
  p {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #fff;
  }
  .card-arrow {
    position: absolute;
    top: 25px;
    right: 25px;
    font-size: 1.3rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: 0.3s;
    color: var(--accent, #10b981);
    z-index: 4;
  }
  .news-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .wide {
    grid-column: span 2;
  }
  .more-news {
    text-align: center;
    margin-top: 40px;
  }
  .secondary-btn {
    display: inline-block;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.8rem 2rem;
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    backdrop-filter: blur(10px);
    transition: border-color 0.3s;
  }
  .secondary-btn:hover {
    border-color: rgba(255,255,255,0.7);
  }
  .news-placeholder {
    text-align: center;
    opacity: 0.7;
    color: #fff;
  }
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .large, .wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .news-card {
      min-height: 220px;
    }
  }
</style>