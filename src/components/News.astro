---
// src/components/News.astro
export const prerender = false;

interface NewsItem {
  title: string;
  link: string;
  pubDate: string;
  content: string;
  image: string | null;
  isoDate: string;
  ownerId: number;
  postId: number;
}

let news: NewsItem[] = [];
const ACCESS_TOKEN = Astro.locals?.runtime?.env?.VK_ACCESS_TOKEN;
const GROUP_ID = '99133048';
const API_VERSION = '5.131';

// --- Ручные заголовки ---
const manualTitles: Record<number, string> = {
  // пример: 119: 'Специальный заголовок',
};

// --- getAttachmentPreview (фото, видео, документы, ссылки) ---
function getAttachmentPreview(attachments: any[]): string | null {
  if (!attachments?.length) return null;
  const first = attachments[0];

  // фото
  if (first.photo?.sizes) {
    const sizes = first.photo.sizes;
    return (
      sizes.find((s: any) => s.type === 'x')?.url ||
      sizes.find((s: any) => s.type === 'y')?.url ||
      sizes[sizes.length - 1]?.url ||
      null
    );
  }
  // видео
  if (first.video?.image?.length) {
    const images = first.video.image;
    return images[images.length - 1]?.url || null;
  }
  // документ
  if (first.doc?.preview?.photo?.sizes) {
    const sizes = first.doc.preview.photo.sizes;
    return (
      sizes.find((s: any) => s.type === 'x')?.url ||
      sizes[sizes.length - 1]?.url ||
      null
    );
  }
  // ссылка
  if (first.link?.photo?.sizes) {
    const sizes = first.link.photo.sizes;
    return (
      sizes.find((s: any) => s.type === 'k')?.url ||
      sizes.find((s: any) => s.type === 'x')?.url ||
      sizes[sizes.length - 1]?.url ||
      null
    );
  }
  return null;
}

// --- Очистка текста ---
function cleanVkText(text: string): string {
  return text
    .replace(/\[club\d+\|([^\]]+)\]/g, '$1')
    .replace(/\[id\d+\|([^\]]+)\]/g, '$1')
    .replace(/https?:\/\/\S+/g, '')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

// --- Автоматический заголовок из вложения ---
function getAutoTitle(attachments: any[]): string | null {
  if (!attachments?.length) return null;
  const first = attachments[0];
  if (first.video?.title) return first.video.title;
  if (first.doc?.title) return first.doc.title;
  if (first.link?.title) return first.link.title;
  return null;
}

// --- Генерация заголовка и контента ---
function prepareTitleAndContent(
  postId: number,
  rawText: string,
  attachments: any[]
): { title: string; content: string } {
  // ручной заголовок
  if (manualTitles[postId]) {
    const title = manualTitles[postId];
    const cleaned = cleanVkText(rawText || '');
    if (!cleaned || cleaned.length <= 60) return { title, content: '' };
    let content = cleaned;
    if (content.startsWith(title)) content = content.slice(title.length).trim();
    if (content.length > 120) content = content.slice(0, 120) + '…';
    return { title, content };
  }

  // заголовок из текста
  const cleaned = cleanVkText(rawText || '');
  if (cleaned) {
    const firstSentenceMatch = cleaned.match(/^(.+?[.!?…])\s/);
    let title: string;
    let remaining: string;
    if (firstSentenceMatch) {
      title = firstSentenceMatch[1];
      remaining = cleaned.slice(firstSentenceMatch[0].length).trim();
    } else {
      title = cleaned.length > 60 ? cleaned.slice(0, 60) + '…' : cleaned;
      remaining = cleaned.length > 60 ? cleaned.slice(60).trim() : '';
    }
    if (remaining.startsWith(title)) remaining = remaining.slice(title.length).trim();
    if (remaining.length > 120) remaining = remaining.slice(0, 120) + '…';
    return { title, content: remaining };
  }

  // автоматический заголовок из вложения
  const autoTitle = getAutoTitle(attachments);
  if (autoTitle) {
    const title = autoTitle.length > 70 ? autoTitle.slice(0, 70) + '…' : autoTitle;
    return { title, content: '' };
  }

  return { title: 'Без названия', content: '' };
}

// --- Загрузка ---
if (!ACCESS_TOKEN) {
  console.warn('VK_ACCESS_TOKEN не задан.');
} else {
  try {
    const ownerId = -Math.abs(parseInt(GROUP_ID));
    const wallUrl = `https://api.vk.com/method/wall.get?owner_id=${ownerId}&count=4&access_token=${ACCESS_TOKEN}&v=${API_VERSION}`;
    const wallRes = await fetch(wallUrl);
    const wallData = await wallRes.json();
    if (!wallData.response) throw new Error('wall.get error');

    news = wallData.response.items.map((post: any) => {
      const ts = post.date;
      const dateObj = ts ? new Date(ts * 1000) : null;
      const { title, content } = prepareTitleAndContent(post.id, post.text || '', post.attachments || []);

      return {
        title,
        link: `https://vk.com/wall${ownerId}_${post.id}`,
        pubDate: dateObj ? dateObj.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) : '',
        content,
        image: getAttachmentPreview(post.attachments),
        isoDate: dateObj ? dateObj.toISOString() : '',
        ownerId,
        postId: post.id,
      };
    });
  } catch (error) {
    console.error('Ошибка загрузки новостей:', error);
  }
}

const BENTO_LAYOUT = ['large', 'small', 'small', 'wide'];
const displayNews = news.slice(0, 4).map((item, i) => ({ ...item, size: BENTO_LAYOUT[i] || 'small' }));
const hasNews = displayNews.length > 0;
---

<section id="news" class="news-section">
  <div class="news-container">
    <div class="section-header">
      <span class="badge">События</span>
      <h2 class="section-title">Новости <span class="accent">Scanova A/S</span></h2>
    </div>

    {hasNews ? (
      <div class="bento-grid">
        {displayNews.map((item) => (
          <a
            href={item.link}
            data-owner-id={item.ownerId}
            data-post-id={item.postId}
            class={`news-card ${item.size}`}
          >
            {item.image && (
              <>
                <div class="card-bg-image" style={`background-image: url(${item.image})`}></div>
                <div class="card-overlay"></div>
              </>
            )}
            <div class="card-content">
              <time class="date" datetime={item.isoDate}>{item.pubDate}</time>
              <h3>{item.title}</h3>
              {item.content && <p>{item.content}</p>}
            </div>
            <span class="card-arrow">→</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-msg">Новости пока не загружены.</p>
    )}

    <div class="more">
      <a href="/news-pages" class="secondary-btn">Все новости</a>
    </div>
  </div>
</section>

<style>
  /* =========================
     FULL-SCREEN SECTION
  ========================= */
  .news-section {
    position: relative;
    min-height: 100svh;          /* полная высота экрана */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(80px, 10vw, 140px) 5%;
    background: radial-gradient(circle at top, rgba(16,185,129,0.08), transparent 35%), #0a0a0a;
    overflow: hidden;
    box-sizing: border-box;
  }

  .news-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.5);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0;
  }

  .accent {
    color: var(--accent);
  }

  /* =========================
     BENTO GRID
  ========================= */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: 20px;
  }

  .news-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: var(--card-bg);
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid var(--border);
    transition: all 0.4s ease;
  }

  .news-card:hover {
    border-color: var(--accent);
    transform: translateY(-5px);
  }

  .card-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    z-index: 2;
  }

  .card-content {
    position: relative;
    z-index: 3;
    padding: 30px;
  }

  .date {
    font-size: 0.7rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.2rem;
    margin: 10px 0;
    line-height: 1.3;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  p {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #fff;
  }

  .card-arrow {
    position: absolute;
    top: 25px;
    right: 25px;
    font-size: 1.3rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: 0.3s;
    color: var(--accent);
    z-index: 4;
  }

  .news-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .wide {
    grid-column: span 2;
  }

  .empty-msg {
    text-align: center;
    opacity: 0.7;
  }

  .more {
    text-align: center;
    margin-top: 40px;
  }

  .secondary-btn {
    display: inline-block;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.8rem 2rem;
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    backdrop-filter: blur(10px);
    transition: border-color 0.3s;
  }

  .secondary-btn:hover {
    border-color: rgba(255,255,255,0.7);
  }

  /* =========================
     MOBILE
  ========================= */
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .large,
    .wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  @media (max-width: 600px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .news-card {
      min-height: 220px;
    }
  }
</style>