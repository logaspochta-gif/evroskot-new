---
// src/components/Hero.astro
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/golpast.jpg";
import hero2 from "../assets/images/hero/Gol.jpg";
import hero3 from "../assets/images/hero/Jersey.jpg";

const slides = [
  {
    img: hero1,
    badge: "Лицензированный экспортер № 2011‑Ø1‑7510‑00068/LHEN",
    title: "Элитный племенной скот",
    subtitle: "из Дании",
    description:
      "Прямые поставки высокопродуктивных животных в РФ и СНГ с полной ветеринарной поддержкой.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Посмотреть породы",
  },
  // … остальные слайды
];
---

<section class="hero" id="hero">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {slides.map((slide, index) => (
        <div class="swiper-slide">
          <div class="slide-bg">
            <Image
              src={slide.img}
              alt=""
              width={1920}
              height={1080}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              class="slide-image"
            />
          </div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge anim-fade-up">{slide.badge}</span>
            <h1 class="anim-fade-up anim-delay-1">
              {slide.title} <br />
              <span class="accent">{slide.subtitle}</span>
            </h1>
            <p class="anim-fade-up anim-delay-2">{slide.description}</p>
            <div class="actions anim-fade-up anim-delay-3">
              <a href="#contact" class="primary-btn">
                {slide.primaryBtn}
              </a>
              <a href="#breeds" class="secondary-btn">
                {slide.secondaryBtn}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .hero-swiper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* GPU-ускорение только для активного слайда */
  .swiper-slide-active .slide-bg {
    will-change: transform;
    transform: translate3d(0, 0, 0);
    animation: heroZoom 1.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes heroZoom {
    0% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .content {
    position: absolute;
    z-index: 10;
    left: max(5%, 2rem);
    top: 50%;
    transform: translateY(-50%);
    max-width: 700px;
    color: #fff;
  }

  .swiper-button-prev,
  .swiper-button-next,
  .swiper-pagination {
    contain: layout style paint;
  }
</style>

<script>
  (() => {
    const heroSwiperEl = document.querySelector(".hero-swiper");
    if (heroSwiperEl && typeof Swiper !== "undefined") {
      new Swiper(heroSwiperEl, {
        loop: true,
        speed: 800,
        autoplay: { delay: 5000 },
        pagination: { el: ".swiper-pagination", clickable: true },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
        effect: "slide",
        preloadImages: false,
        watchSlidesProgress: true,
        lazy: true,
      });
    }
  })();
</script>