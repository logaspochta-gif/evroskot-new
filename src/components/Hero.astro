---
// src/components/Hero.astro
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/golpast.jpg";
import hero2 from "../assets/images/hero/Gol.jpg";
import hero3 from "../assets/images/hero/Jersey.jpg";

const slides = [
  {
    img: hero1,
    badge: "Лицензированный экспортер № 2011‑Ø1‑7510‑00068/LHEN",
    title: "Элитный племенной скот",
    subtitle: "из Дании",
    description:
      "Прямые поставки высокопродуктивных животных в РФ и СНГ с полной ветеринарной поддержкой.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Посмотреть породы",
  },
  {
    img: hero2,
    badge: "Голштинская порода",
    title: "Мировой лидер",
    subtitle: "по удоям молока",
    description:
      "Генетика из лучших хозяйств Дании. Продуктивность до 12 000 кг молока за лактацию.",
    primaryBtn: "Запросить подбор",
    secondaryBtn: "Все породы",
  },
  {
    img: hero3,
    badge: "Джерсейская порода",
    title: "Высокая жирность",
    subtitle: "и долголетие",
    description: "Идеальна для сыроварения. Жирность молока до 6%.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Смотреть породы",
  },
];
---

<section class="hero" id="hero">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {slides.map((slide, index) => (
        <div class="swiper-slide">
          <div class="slide-bg">
            <Image
              src={slide.img}
              alt=""
              width={1920}
              height={1080}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              class="slide-image"
            />
          </div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge">{slide.badge}</span>
            <h1>
              {slide.title} <br />
              <span class="accent">{slide.subtitle}</span>
            </h1>
            <p>{slide.description}</p>
            <div class="actions">
              <a href="#contact" class="primary-btn">{slide.primaryBtn}</a>
              <a href="#breeds" class="secondary-btn">{slide.secondaryBtn}</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .hero-swiper,
  .swiper-wrapper,
  .swiper-slide {
    width: 100%;
    height: 100%;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .content {
    position: absolute;
    z-index: 10;
    left: 5%;
    top: 50%;
    transform: translateY(-50%);
    max-width: 700px;
    color: #fff;
  }

  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.5);
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 3rem;
    margin: 0 0 1rem;
    line-height: 1.1;
    font-weight: 900;
  }

  .accent { color: var(--accent); }

  .content p {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-btn,
  .secondary-btn {
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-btn {
    background: var(--accent);
    color: #fff;
  }

  .secondary-btn {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }

  .swiper-button-prev,
  .swiper-button-next {
    color: #fff;
  }

  .swiper-pagination-bullet-active {
    background: var(--accent);
  }
</style>

<script>
  (function() {
    console.log('[Hero] Скрипт запущен');

    const el = document.querySelector('.hero-swiper');
    if (!el) {
      console.error('[Hero] .hero-swiper не найден');
      return;
    }
    console.log('[Hero] .hero-swiper найден', el);

    if (typeof window.Swiper === 'undefined') {
      console.error('[Hero] window.Swiper не определён – проверьте CDN');
      return;
    }
    console.log('[Hero] window.Swiper доступен');

    const swiper = new Swiper(el, {
      loop: false,
      rewind: true,
      speed: 800,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      on: {
        init() {
          // @ts-ignore
          console.log('[Hero] Swiper инициализирован. Слайды:', this.slides.length);
          // @ts-ignore
          console.log('[Hero] Активный индекс:', this.activeIndex);
        },
        slideChange() {
          // @ts-ignore
          console.log('[Hero] Переключение на индекс', this.activeIndex);
        },
        autoplayStart() {
          console.log('[Hero] Автопрокрутка запущена');
        },
        autoplayStop() {
          console.log('[Hero] Автопрокрутка остановлена');
        },
      },
    });

    console.log('[Hero] Swiper создан:', swiper);
  })();
</script>