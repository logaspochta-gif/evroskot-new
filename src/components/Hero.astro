---
// src/components/Hero.astro
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/golpast.jpg";
import hero2 from "../assets/images/hero/Gol.jpg";
import hero3 from "../assets/images/hero/Jersey.jpg";

const slides = [
  {
    img: hero1,
    badge: "Лицензированный экспортер № 2011‑Ø1‑7510‑00068/LHEN",
    title: "Элитный племенной скот",
    subtitle: "из Дании",
    description:
      "Прямые поставки высокопродуктивных животных в РФ и СНГ с полной ветеринарной поддержкой.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Посмотреть породы",
  },
  {
    img: hero2,
    badge: "Голштинская порода",
    title: "Мировой лидер",
    subtitle: "по удоям молока",
    description:
      "Генетика из лучших хозяйств Дании. Продуктивность до 12 000 кг молока за лактацию.",
    primaryBtn: "Запросить подбор",
    secondaryBtn: "Все породы",
  },
  {
    img: hero3,
    badge: "Джерсейская порода",
    title: "Высокая жирность",
    subtitle: "и долголетие",
    description: "Идеальна для сыроварения. Жирность молока до 6%.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Смотреть породы",
  },
];
---

<section class="hero" id="hero">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {slides.map((slide, index) => (
        <div class="swiper-slide">
          <div class="slide-bg">
            <Image
              src={slide.img}
              alt=""
              width={1920}
              height={1080}
              sizes="(max-width: 768px) 100vw, 1920px"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              decoding="async"
              class="slide-image"
            />
          </div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge anim-fade-up">{slide.badge}</span>
            <h1 class="anim-fade-up anim-delay-1">
              {slide.title} <br />
              <span class="accent">{slide.subtitle}</span>
            </h1>
            <p class="anim-fade-up anim-delay-2">{slide.description}</p>
            <div class="actions anim-fade-up anim-delay-3">
              <a href="#contact" class="primary-btn">{slide.primaryBtn}</a>
              <a href="#breeds" class="secondary-btn">{slide.secondaryBtn}</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    height: 100dvh;
    overflow: hidden;
    scroll-snap-align: start;
    touch-action: pan-y;
  }

  .hero-swiper,
  .swiper-wrapper,
  .swiper-slide {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    position: relative;
    overflow: hidden;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .content {
    position: absolute;
    z-index: 10;
    left: max(5%, 2rem);
    top: 50%;
    transform: translateY(-50%);
    max-width: 700px;
    color: #fff;
  }

  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.5);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: clamp(0.7rem, 2vh, 0.9rem);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  h1, h2 {
    font-size: clamp(2rem, 7vh, 4rem);
    margin: 0 0 1rem;
    line-height: 1.1;
    font-weight: 900;
    color: #fff;
  }

  .accent { color: var(--accent); }

  .content p {
    font-size: clamp(0.9rem, 2.5vh, 1.2rem);
    opacity: 0.9;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-btn,
  .secondary-btn {
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .primary-btn {
    background: var(--accent);
    color: #fff;
  }
  .primary-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .secondary-btn {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }
  .secondary-btn:hover { transform: translateY(-2px); }

  /* Анимации текста */
  .anim-fade-up {
    opacity: 0;
    transform: translate3d(0, 30px, 0);
    transition: none; /* без transition, работает animation */
  }

  .anim-fade-up.animated {
    animation: fadeUp 0.8s ease forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translate3d(0, 30px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .anim-delay-1.animated { animation-delay: 0.3s; }
  .anim-delay-2.animated { animation-delay: 0.6s; }
  .anim-delay-3.animated { animation-delay: 0.9s; }

  @media (prefers-reduced-motion: reduce) {
    .anim-fade-up.animated {
      animation: none;
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
</style>

<script type="module" src="../scripts/hero-swiper.js"></script>