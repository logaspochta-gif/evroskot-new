---
---
<>
  <section class="hero" id="hero">
    <!-- Шапка -->
    <nav class="navbar" id="navbar">
      <div class="logo">
        <svg width="160" height="30" viewBox="0 0 160 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <text x="0" y="25" font-family="Poppins" font-weight="900" font-size="24" fill="currentColor">
            EVRO<tspan fill="#10b981">SKOT</tspan>
          </text>
        </svg>
      </div>
      <button class="burger" id="burger" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>
      <div class="menu" id="menu">
        <a href="#hero">Главная</a>
        <a href="#breeds">Породы</a>
        <a href="#about">О компании</a>
        <a href="#staldren">Staldren®</a>
        <a href="/news">Новости</a>    <!-- новая ссылка -->
        <a href="#contact"><button class="btn-contact">Связаться</button></a>
      </div>
    </nav>

    <!-- Слайдер -->
    <div class="swiper hero-swiper">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <div class="slide-bg" style="background-image: url('https://i.pinimg.com/736x/38/af/34/38af34b6ce41eb7bc57cd89aa9b52d7d.jpg?auto=format&fit=crop&w=1920&q=80');"></div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge animate__animated animate__fadeInUp">Лицензированный экспортер № 2011‑Ø1</span>
            <h1 class="animate__animated animate__fadeInUp animate__delay-1s">Элитный племенной скот <br/> <span class="accent">из Дании</span></h1>
            <p class="animate__animated animate__fadeInUp animate__delay-2s">Прямые поставки высокопродуктивных животных в РФ и СНГ с полной ветеринарной поддержкой.</p>
            <div class="actions animate__animated animate__fadeInUp animate__delay-3s">
              <a href="#contact" class="primary-btn">Запросить прайс</a>
              <a href="#breeds" class="secondary-btn">Посмотреть породы</a>
            </div>
          </div>
        </div>
        <div class="swiper-slide">
          <div class="slide-bg" style="background-image: url('https://images.unsplash.com/photo-1746401671955-60e6e1039904?auto=format&fit=crop&w=1920&q=80');"></div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge">Голштинская порода</span>
            <h1>Мировой лидер <br/> <span class="accent">по удоям молока</span></h1>
            <p>Генетика из лучших хозяйств Дании. Продуктивность до 12 000 кг молока за лактацию.</p>
            <div class="actions">
              <a href="#contact" class="primary-btn">Запросить подбор</a>
              <a href="#breeds" class="secondary-btn">Все породы</a>
            </div>
          </div>
        </div>
        <div class="swiper-slide">
          <div class="slide-bg" style="background-image: url('https://images.unsplash.com/photo-1592249991251-5abf6a8beac6?auto=format&fit=crop&w=1920&q=80');"></div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge">Джерсейская порода</span>
            <h1>Высокая жирность <br/> <span class="accent">и долголетие</span></h1>
            <p>Идеальна для сыроварения. Жирность молока до 6%.</p>
            <div class="actions">
              <a href="#contact" class="primary-btn">Запросить прайс</a>
              <a href="#breeds" class="secondary-btn">Смотреть породы</a>
            </div>
          </div>
        </div>
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </section>
</>

<style>
  :root {
    --accent: #10b981;
    --accent-hover: #059669;
    --border: rgba(255,255,255,0.1);
  }

  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  .hero-swiper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    animation: srmgani 4s ease forwards;
  }
  @keyframes srmgani {
    0% { transform: scale(1.05); }
    100% { transform: scale(1.0); }
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.75), rgba(0,0,0,0.4));
    z-index: 1;
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 5%;
    background: rgba(0,0,0,0.05);
    backdrop-filter: blur(5px);
  }
  .logo svg {
    width: 120px;
    fill: currentColor;
    color: #fff;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .menu a {
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    position: relative;
    padding-bottom: 5px;
  }
  .menu a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .menu a:hover::after { opacity: 1; }
  .btn-contact {
    background: var(--accent);
    color: #fff;
    padding: 0.6rem 1.8rem;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    z-index: 200;
  }
  .burger span {
    width: 28px;
    height: 3px;
    background: #fff;
    border-radius: 3px;
  }

  .content {
    position: absolute;
    z-index: 10;
    left: 9.5%;
    top: 50%;
    transform: translateY(-50%);
    max-width: 700px;
  }
  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.5);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1.5rem;
    color: #fff;
  }
  h1 {
    font-size: 3.8rem;
    margin: 0 0 1rem;
    line-height: 1.1;
    font-weight: 900;
    color: #fff;
  }
  .accent { color: var(--accent); }
  .content p {
    font-size: 1.15rem;
    opacity: 0.9;
    margin-bottom: 2rem;
    max-width: 500px;
  }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .primary-btn {
    background: var(--accent);
    color: #fff;
    padding: 0.9rem 2rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 700;
    display: inline-block;
  }
  .secondary-btn {
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 0.9rem 2rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    backdrop-filter: blur(10px);
  }

  @media (max-width: 768px) {
    h1 { font-size: 2.2rem; }
    .menu {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 70px;
      right: 5%;
      background: rgba(0,0,0,0.9);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 1.5rem;
      gap: 1rem;
    }
    .menu.active { display: flex; }
    .burger { display: flex; }
    .content { left: 5%; right: 5%; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Swiper
    const heroSwiperEl = document.querySelector('.hero-swiper');
    if (heroSwiperEl && typeof Swiper !== 'undefined') {
      new Swiper(heroSwiperEl, {
        loop: true,
        autoplay: { delay: 5000, disableOnInteraction: false },
        pagination: { el: '.swiper-pagination', clickable: true },
        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
        effect: 'fade',
        fadeEffect: { crossFade: true },
      });
    }

    // Бургер-меню
    const burger = document.getElementById('burger');
    const menu = document.getElementById('menu');
    if (burger && menu) {
      burger.addEventListener('click', () => menu.classList.toggle('active'));
      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => menu.classList.remove('active'));
      });
    }

    // Полноэкранная прокрутка колесом мыши (вверх и вниз)
    const sections = [
      document.getElementById('hero'),                               // 1
      document.getElementById('bento-breeds') || document.querySelector('.bento-section'), // 2
      document.getElementById('about'),                              // 3
      document.getElementById('steps'),                   // новая секция
      document.getElementById('breeds'),                             // 4 (BreedsDetailed)
      document.getElementById('advantages'),                         // 5
      document.getElementById('staldren'),                           // 6
      document.getElementById('contact')                             // 7
    ].filter(Boolean);

    let currentIndex = 0;
    let isScrolling = false;
    const scrollCooldown = 800;

    function updateCurrentIndex() {
      const scrollCenter = window.scrollY + window.innerHeight / 2;
      for (let i = sections.length - 1; i >= 0; i--) {
        const el = sections[i];
        if (el && el.offsetTop <= scrollCenter) {
          currentIndex = i;
          break;
        }
      }
    }

    function scrollToSection(index: number) { // явный тип параметра
      if (index < 0 || index >= sections.length) return;
      const target = sections[index];
      if (target) {
        isScrolling = true;
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => {
          isScrolling = false;
          updateCurrentIndex();
        }, scrollCooldown);
      }
    }

    window.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (isScrolling) return;
      updateCurrentIndex();
      if (e.deltaY > 0) {
        scrollToSection(currentIndex + 1);
      } else if (e.deltaY < 0) {
        scrollToSection(currentIndex - 1);
      }
    }, { passive: false });

    window.addEventListener('resize', updateCurrentIndex);
    updateCurrentIndex();
  });
</script>