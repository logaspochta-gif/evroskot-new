---
// src/components/Hero.astro
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/golpast.jpg";
import hero2 from "../assets/images/hero/Gol.jpg";
import hero3 from "../assets/images/hero/Jersey.jpg";

const slides = [
  {
    img: hero1,
    badge: "Лицензированный экспортер № 2011‑Ø1‑7510‑00068/LHEN",
    title: "Элитный племенной скот",
    subtitle: "из Дании",
    description:
      "Прямые поставки высокопродуктивных животных в РФ и СНГ с полной ветеринарной поддержкой.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Посмотреть породы",
  },
  {
    img: hero2,
    badge: "Голштинская порода",
    title: "Мировой лидер",
    subtitle: "по удоям молока",
    description:
      "Генетика из лучших хозяйств Дании. Продуктивность до 12 000 кг молока за лактацию.",
    primaryBtn: "Запросить подбор",
    secondaryBtn: "Все породы",
  },
  {
    img: hero3,
    badge: "Джерсейская порода",
    title: "Высокая жирность",
    subtitle: "и долголетие",
    description: "Идеальна для сыроварения. Жирность молока до 6%.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Смотреть породы",
  },
];
---

<section class="hero" id="hero">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {slides.map((slide, index) => (
        <div class="swiper-slide">
          <div class="slide-bg">
            <Image
              src={slide.img}
              alt=""
              width={1920}
              height={1080}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              class="slide-image"
            />
          </div>
          <div class="overlay"></div>
          <div class="content">
            <span class="badge anim-fade-up">{slide.badge}</span>
            <h1 class="anim-fade-up anim-delay-1">
              {slide.title} <br />
              <span class="accent">{slide.subtitle}</span>
            </h1>
            <p class="anim-fade-up anim-delay-2">{slide.description}</p>
            <div class="actions anim-fade-up anim-delay-3">
              <a href="#contact" class="primary-btn">{slide.primaryBtn}</a>
              <a href="#breeds" class="secondary-btn">{slide.secondaryBtn}</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    height: 100dvh;
    overflow: hidden;
    scroll-snap-align: start;
    touch-action: pan-y;           /* разрешаем вертикальный скролл */
  }

  .hero-swiper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* GPU-ускорение и анимация только для активного слайда */
  .swiper-slide-active .slide-bg {
    will-change: transform;
    transform: translate3d(0, 0, 0);
    animation: heroZoom 1.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes heroZoom {
    0% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .content {
    position: absolute;
    z-index: 10;
    left: max(5%, 2rem);
    top: 50%;
    transform: translateY(-50%);
    max-width: 700px;
    color: #fff;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-btn,
  .secondary-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .primary-btn {
    background: var(--accent);
    color: #fff;
  }

  .primary-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .secondary-btn {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
  }

  .secondary-btn:hover { transform: translateY(-2px); }

  .swiper-button-prev,
  .swiper-button-next,
  .swiper-pagination {
    contain: layout style paint;
  }

  .anim-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .anim-fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .anim-delay-1 { transition-delay: 0.3s; }
  .anim-delay-2 { transition-delay: 0.6s; }
  .anim-delay-3 { transition-delay: 0.9s; }
</style>

<script>
  // Используем window.onload для уверенности, что Swiper уже загружен
  window.addEventListener('load', () => {
    const heroSwiperEl = document.querySelector('.hero-swiper');
    if (heroSwiperEl && window.Swiper) {
      new Swiper(heroSwiperEl, {
        loop: true,
        speed: 800,
        autoplay: { delay: 5000 },
        pagination: { el: '.swiper-pagination', clickable: true },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        effect: 'slide',
        preloadImages: false,
        watchSlidesProgress: true,
        lazy: true,
      });
    } else {
      console.warn('Swiper not loaded or hero-swiper element not found');
    }
  });
</script>