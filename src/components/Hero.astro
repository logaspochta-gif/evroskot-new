---
// src/components/Hero.astro
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/golpast.jpg";
import hero2 from "../assets/images/hero/Gol.jpg";
import hero3 from "../assets/images/hero/Jersey.jpg";

const slides = [
  {
    img: hero1,
    badge: "Лицензированный экспортер № 2011‑Ø1‑7510‑00068/LHEN",
    title: "Элитный племенной скот",
    subtitle: "из Дании",
    description:
      "Прямые поставки высокопродуктивных животных в РФ и СНГ с полной ветеринарной поддержкой.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Посмотреть породы",
  },
  {
    img: hero2,
    badge: "Голштинская порода",
    title: "Мировой лидер",
    subtitle: "по удоям молока",
    description:
      "Генетика из лучших хозяйств Дании. Продуктивность до 12 000 кг молока за лактацию.",
    primaryBtn: "Запросить подбор",
    secondaryBtn: "Все породы",
  },
  {
    img: hero3,
    badge: "Джерсейская порода",
    title: "Высокая жирность",
    subtitle: "и долголетие",
    description: "Идеальна для сыроварения. Жирность молока до 6%.",
    primaryBtn: "Запросить прайс",
    secondaryBtn: "Смотреть породы",
  },
];
---

<section class="hero" id="hero">
  <div class="slides" id="hero-slides">
    {slides.map((slide, index) => (
      <div class="slide" id={`slide-${index}`}>
        <div class="slide-bg">
          <Image
            src={slide.img}
            alt=""
            widths={[480, 768, 1280, 1920]}
            sizes="100vw"
            format="avif"
            quality={65}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding={index === 0 ? "sync" : "async"}
            class="slide-image"
          />
        </div>
        <div class="content">
          <span class="badge">{slide.badge}</span>
          <h1>
            {slide.title} <br />
            <span class="accent">{slide.subtitle}</span>
          </h1>
          <p>{slide.description}</p>
          <div class="actions">
            <a href="#contact" class="primary-btn">{slide.primaryBtn}</a>
            <a href="#breeds" class="secondary-btn">{slide.secondaryBtn}</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="dots" id="hero-dots">
    {slides.map((_, index) => (
      <button class="dot" data-index={index} aria-label={`Перейти к слайду ${index + 1}`}>
      </button>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    height: 100svh;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .slides {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    height: 100%;
    scrollbar-width: none;
  }
  .slides::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    contain: layout paint;
  }

  /* Оверлей теперь псевдоэлемент */
  .slide::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 5%;
    max-width: 800px;
    color: #fff;
    z-index: 10;
  }

  .badge {
    display: inline-block;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.5);
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
    width: fit-content;
  }

  h1 {
    font-size: clamp(2rem, 8vh, 4.5rem);
    margin: 0 0 1rem;
    line-height: 1.1;
    font-weight: 900;
    color: #fff;
  }

  .accent { color: var(--accent); }

  .content p {
    font-size: clamp(0.9rem, 2.5vh, 1.2rem);
    opacity: 0.9;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-btn,
  .secondary-btn {
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .primary-btn {
    background: var(--accent);
    color: #fff;
  }
  .primary-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .secondary-btn {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }
  .secondary-btn:hover { transform: translateY(-2px); }

  .dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 20;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: none;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
    padding: 0;
    font-size: 0;
  }

  .dot.active {
    background: var(--accent);
    transform: scale(1.3);
  }

  @media (max-width: 768px) {
    .content {
      padding: 1.5rem 5%;
    }
  }
</style>

<script>
  (() => {
    const slidesContainer = document.getElementById('hero-slides');
    if (!slidesContainer) return;

    const dots = document.querySelectorAll('#hero-dots .dot');
    if (dots.length === 0) return;

    let currentIndex = 0;
    const totalSlides = dots.length;
    let interval: ReturnType<typeof setInterval> | null = null;
    let ticking = false;

    function goTo(index: number) {
      if (!slidesContainer) return;
      slidesContainer.scrollTo({
        left: index * slidesContainer.clientWidth,
        behavior: 'smooth',
      });
    }

    function updateDots(index: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
      });
    }

    function startAutoplay() {
      if (interval) clearInterval(interval);
      interval = setInterval(() => {
        currentIndex = (currentIndex + 1) % totalSlides;
        goTo(currentIndex);
        updateDots(currentIndex);
      }, 5000);
    }

    function stopAutoplay() {
      if (interval) {
        clearInterval(interval);
        interval = null;
      }
    }

    startAutoplay();

    if (slidesContainer) {
      slidesContainer.addEventListener('mouseenter', stopAutoplay);
      slidesContainer.addEventListener('mouseleave', startAutoplay);
    }

    dots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        const targetDot = e.currentTarget as HTMLElement;
        const indexStr = targetDot.dataset.index;
        if (indexStr === undefined) return;
        currentIndex = parseInt(indexStr, 10);
        goTo(currentIndex);
        updateDots(currentIndex);
        stopAutoplay();
        startAutoplay();
      });
    });

    if (slidesContainer) {
      slidesContainer.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              if (!slidesContainer) return;
              const scrollLeft = slidesContainer.scrollLeft;
              const width = slidesContainer.clientWidth;
              if (width === 0) return;
              const newIndex = Math.round(scrollLeft / width);
              if (newIndex !== currentIndex) {
                currentIndex = newIndex;
                updateDots(currentIndex);
              }
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true },
      );
    }

    updateDots(0);
  })();
</script>